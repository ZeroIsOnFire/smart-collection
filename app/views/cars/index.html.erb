<div class="container-fluid py-4 app-container">
  <%= turbo_stream_from "cars_#{current_user.id.to_s}" %>
  <%= turbo_stream_from "user_#{current_user.id.to_s}_exports" %>
  <% csv_export = current_user.collection_exports.where(format_type: 'csv').last %>
  <% pdf_export = current_user.collection_exports.where(format_type: 'pdf').last %>
  <% cars_results_count = @cars.total_count %>
  <% search_query = params[:q].to_s.strip %>
  <% car_filters_active = params.values_at(:brand, :size, :year, :color).any?(&:present?) %>

  <!-- Cabeçalho -->
  <div class="collection-toolbar d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
    <div>
      <h1 class="fw-bold mb-0 fs-3"><%= t("nav.my_cars") %></h1>
      <p class="text-muted small mb-0"><%= t("cars.index.subtitle") %></p>
    </div>
    <div class="collection-primary-actions d-flex gap-2 flex-wrap justify-content-end">
      <%= render "autodetections/form_button", autodetection: Autodetection.new %>
      <%= link_to new_car_path,
                  class: 'btn btn-premium rounded-3 px-4 d-flex align-items-center gap-2',
                  data: { turbo_frame: "modal" } do %>
        <i class="bi bi-plus-circle"></i> <%= t("items.new") %>
      <% end %>

      <div class="dropdown collection-secondary-actions">
        <button class="btn btn-soft-secondary rounded-3 px-4 d-flex align-items-center gap-2"
                type="button"
                data-bs-toggle="dropdown"
                data-bs-auto-close="outside"
                aria-expanded="false">
          <i class="bi bi-three-dots"></i>
          <span><%= t("cars.index.secondary_actions") %></span>
        </button>

        <div class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-3 p-3 collection-secondary-menu">
          <% if current_user.sharing_enabled? %>
            <div class="mb-2" data-controller="clipboard"
                 data-clipboard-success-content-value="<i class='bi bi-check2'></i> <span><%= t("cars.index.public_link_copied") %></span>"
                 data-clipboard-default-class-value="btn-outline-primary"
                 data-clipboard-success-class-value="btn-primary">
              <input type="hidden" data-clipboard-target="source" value="<%= public_share_url(current_user.share_token, current_locale_param) %>">
              <button class="btn btn-outline-primary rounded-3 w-100 d-flex align-items-center justify-content-center gap-2"
                      type="button"
                      data-action="clipboard#copy"
                      data-clipboard-target="button">
                <i class="bi bi-share"></i>
                <span><%= t("cars.index.copy_public_link") %></span>
              </button>
            </div>
            <%= link_to public_share_url(current_user.share_token),
                        class: "btn btn-soft-secondary rounded-3 w-100 d-flex align-items-center justify-content-center gap-2 mb-2",
                        target: "_blank",
                        rel: "noopener noreferrer",
                        data: { turbo: false } do %>
              <i class="bi bi-box-arrow-up-right"></i>
              <%= t("wishlist_items.actions.open_public") %>
            <% end %>
          <% end %>

          <%= button_to toggle_sharing_cars_path,
                        method: :patch,
                        class: "btn #{current_user.sharing_enabled? ? 'btn-light text-danger' : 'btn-premium'} rounded-3 w-100 d-flex align-items-center justify-content-center gap-2 mb-3" do %>
            <% if current_user.sharing_enabled? %>
              <i class="bi bi-x-circle"></i>
              <span><%= t('sharing_settings.disable') %></span>
            <% else %>
              <i class="bi bi-check-circle"></i>
              <span><%= t('sharing_settings.enable') %></span>
            <% end %>
          <% end %>

          <div class="small fw-bold text-muted text-uppercase mb-2">
            <%= t("cars.index.export_actions") %>
          </div>
          <div class="d-grid gap-2">
            <%= render partial: "collection_exports/export_status", locals: { export: csv_export, format_type: 'csv' } %>
            <%= render partial: "collection_exports/export_status", locals: { export: pdf_export, format_type: 'pdf' } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Autodetections em andamento -->
  <%= turbo_stream_from "autodetections_#{current_user.id.to_s}" %>
  <%= render "autodetections/panel", autodetections: @autodetections %>

  <!-- Campo de Busca Full Text -->
  <div class="row mb-4">
    <div class="col-12 col-lg-8 mx-auto">
      <%= form_with url: cars_path,
                    method: :get,
                    class: "position-relative",
                    data: {
                      controller: "search-form",
                      turbo_frame: "cars_grid"
                    } do |f| %>
        <div class="collection-search-controls d-flex gap-2 align-items-stretch">
          <div class="input-group input-group-lg premium-search-container shadow-sm border rounded-3 overflow-hidden bg-white flex-grow-1">
            <span class="input-group-text border-0 bg-transparent ps-4">
              <i class="bi bi-search text-muted"></i>
            </span>
            <%= f.text_field :q,
                             value: params[:q],
                             placeholder: t("cars.index.search_placeholder"),
                             class: "form-control border-0 bg-transparent py-3 shadow-none",
                             autocomplete: "off",
                             data: {
                               search_form_target: "input",
                               action: "input->search-form#submit"
                             } %>

            <div class="search-status d-none d-flex align-items-center me-2"
                 role="status"
                 aria-live="polite"
                 data-search-form-target="spinner">
              <div class="spinner-border spinner-border-sm text-primary" role="status">
                <span class="visually-hidden"><%= t("cars.index.searching") %></span>
              </div>
              <span class="search-status-label"><%= t("cars.index.searching") %></span>
            </div>

            <% if params[:q].present? || car_filters_active %>
              <%= link_to cars_path,
                          class: "btn border-0 bg-transparent text-muted px-4 d-flex align-items-center search-clear-button",
                          title: t("cars.index.clear_search"),
                          aria: { label: t("cars.index.clear_search") } do %>
                <i class="bi bi-x-circle"></i>
              <% end %>
            <% end %>

            <button type="submit" class="btn btn-premium px-4 rounded-3 m-1 d-none d-sm-block">
              <%= t("actions.search") %>
            </button>
            <button type="submit" class="btn btn-premium px-3 rounded-3 m-1 d-sm-none" aria-label="<%= t('actions.search') %>">
              <i class="bi bi-search"></i>
            </button>
          </div>

          <div class="dropdown">
            <button class="btn btn-soft-secondary collection-filter-button px-3 rounded-3 d-flex align-items-center gap-2 h-100"
                    type="button"
                    data-bs-toggle="dropdown"
                    data-bs-auto-close="outside"
                    aria-expanded="false"
                    aria-label="<%= t('cars.index.filter_menu') %>">
              <i class="bi bi-sliders"></i>
              <span class="d-none d-sm-inline"><%= t('cars.index.filter_menu') %></span>
            </button>
            <div class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-3 p-3 collection-filter-menu">
              <div class="small fw-bold text-muted text-uppercase mb-3">
                <%= t('cars.index.filter_menu') %>
              </div>

              <div class="mb-3">
                <%= f.label :size, t('activerecord.attributes.car.size'), class: "form-label small fw-semibold text-muted" %>
                <%= f.select :size,
                             options_for_select([[t('cars.index.filters.all_scales'), '']] + Car.scale_options, params[:size]),
                             {},
                             class: "form-select rounded-3" %>
              </div>

              <div class="mb-3">
                <%= f.label :brand, t('activerecord.attributes.car.brand'), class: "form-label small fw-semibold text-muted" %>
                <%= f.select :brand,
                             options_for_select([[t('cars.index.filters.all_brands'), '']] + @brands.map { |brand| [brand, brand] }, params[:brand]),
                             {},
                             class: "form-select rounded-3" %>
              </div>

              <div class="mb-3">
                <%= f.label :year, t('activerecord.attributes.car.year'), class: "form-label small fw-semibold text-muted" %>
                <%= f.select :year,
                             options_for_select([[t('cars.index.filters.all_years'), '']] + @years.map { |year| [year, year] }, params[:year]),
                             {},
                             class: "form-select rounded-3" %>
              </div>

              <div class="mb-3">
                <%= f.label :color, t('activerecord.attributes.car.color'), class: "form-label small fw-semibold text-muted" %>
                <%= f.select :color,
                             options_for_select([[t('cars.index.filters.all_colors'), '']] + Car.color_options, params[:color]),
                             {},
                             class: "form-select rounded-3" %>
              </div>

              <div class="d-grid gap-2">
                <button type="submit" class="btn btn-premium rounded-3">
                  <i class="bi bi-funnel me-1"></i>
                  <%= t('actions.filter') %>
                </button>
                <%= link_to cars_path,
                            class: "btn btn-soft-secondary rounded-3",
                            title: t("cars.index.clear_search"),
                            aria: { label: t("cars.index.clear_search") } do %>
                  <%= t('cars.index.clear_filters') %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- View Toggle Wrapper -->
  <turbo-frame id="cars_grid">
  <div data-controller="view-toggle">
    <div class="collection-view-controls d-flex justify-content-between align-items-center">
      <div class="collection-results-summary text-muted small" aria-live="polite">
        <% if search_query.present? %>
          <%= t("cars.index.results_count_filtered", count: cars_results_count, query: search_query) %>
        <% else %>
          <%= t("cars.index.results_count", count: cars_results_count) %>
        <% end %>
      </div>
      <div class="btn-group shadow-sm bg-white rounded-3 p-1 border">
        <button type="button" class="btn btn-sm text-primary active rounded-3 px-3 fw-medium d-flex align-items-center gap-2" data-view-toggle-target="gridButton" data-action="click->view-toggle#setGrid">
          <i class="bi bi-grid-fill"></i> <%= t("cars.index.grid_view") %>
        </button>
        <button type="button" class="btn btn-sm text-muted rounded-3 px-3 fw-medium d-flex align-items-center gap-2" data-view-toggle-target="listButton" data-action="click->view-toggle#setList">
          <i class="bi bi-list-ul"></i> <%= t("cars.index.list_view") %>
        </button>
      </div>
    </div>

    <!-- Grid de carros -->
      <div id="cars_list_container" class="position-relative">
        <% if @cars.any? || current_user.cars.any? %>
          <div id="cars_grid_inner" class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4 mt-2 grid-view">
            <%= render partial: "cars/car", collection: @cars, cached: true %>
          </div>

          <!-- Sentinela para infinite scroll -->
          <% if @has_more %>
            <div id="cars_sentinel" class="row mt-4">
              <%= render partial: "cars/sentinel", locals: { next_page: @cars.next_page } %>
            </div>
          <% end %>

        <% else %>
          <!-- Estado vazio -->
          <div id="cars_grid_inner" class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4 mt-2 grid-view"></div>
          <div id="cars_empty_state" class="text-center py-5 mt-4">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light mb-4" style="width: 80px; height: 80px;">
              <i class="bi bi-collection fs-2 text-muted opacity-50"></i>
            </div>
            <h4 class="fw-bold mb-2"><%= t("cars.index.empty_title") %></h4>
            <p class="text-muted mb-4"><%= t("cars.index.empty_text") %></p>
            <%= link_to new_car_path, class: 'btn btn-premium rounded-3 px-5', data: { turbo_frame: "modal" } do %>
              <i class="bi bi-plus-circle me-2"></i> <%= t("cars.index.add_first_item") %>
            <% end %>
          </div>
        <% end %>
      </div>
  </div>
  </turbo-frame>

</div>
