<% target_url = local_assigns[:url] || cars_path(page: next_page, format: :turbo_stream) %>
<div id="cars_sentinel"
     class="col-12 text-center py-4"
     data-controller="infinite-scroll"
     data-infinite-scroll-url-value="<%= target_url %>"
     data-infinite-scroll-has-more-value="true">
    <div class="spinner-border spinner-border-sm text-muted" role="status">
      <span class="visually-hidden">Carregando mais...</span>
    </div>
    <p class="text-muted small mt-1 mb-0">Carregando mais itens...</p>
  </div>
