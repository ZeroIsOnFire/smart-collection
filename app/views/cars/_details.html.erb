<% modal = local_assigns.fetch(:modal, false) %>
<% car_dom_id = car.id.to_s %>
<% display_user = car_display_user(car, local_assigns[:user]) %>
<% display_photo_url = car_display_photo_url(car, user: display_user) %>
<% original_photo_url = car_photo_url(car, car.original_photo) %>
<% display_photo_upscaled_by_ai = car_display_photo_upscaled_by_ai?(car, user: display_user) %>
<% variant_toggle_available = car_show_original_photo_link?(car, user: display_user) %>

<div id="car_details_<%= car_dom_id %>">
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <% unless modal %>
    <%= link_to cars_path, class: "btn btn-outline-secondary rounded-3 px-4 d-inline-flex align-items-center" do %>
      <i class="bi bi-arrow-left me-2"></i> <%= t("cars.show.collection") %>
    <% end %>
  <% end %>

  <div class="d-flex align-items-center gap-2 ms-auto">
    <%= link_to edit_car_path(car),
                class: "btn btn-premium rounded-3 d-inline-flex align-items-center justify-content-center",
                style: "min-width: 112px;",
                data: { turbo_frame: modal ? "modal" : "_top" } do %>
      <i class="bi bi-pencil me-2"></i><%= t("actions.edit") %>
    <% end %>
    <%= button_to car,
                  method: :delete,
                  form: {
                    class: "d-inline-flex m-0",
                    data: {
                      "car-removal-car-id": car_dom_id,
                      modal_frame_skip_loading: modal ? true : nil
                    }
                  },
                  data: {
                    car_removal_trigger: true,
                    car_removal_car_id: car_dom_id,
                    car_removal_confirm_message: t("items.delete_confirm")
                  },
                  class: "btn btn-outline-danger rounded-3 d-inline-flex align-items-center justify-content-center",
                  style: "padding: 0.65rem 1.5rem; min-width: 112px;" do %>
      <i class="bi bi-trash3 me-2"></i><%= t("actions.delete") %>
    <% end %>
  </div>
</div>

<% cache [car, modal ? :modal : :page, car_photo_cache_key(car, user: display_user)] do %>
  <div class="card premium-card car-details-card shadow-sm rounded-3 overflow-hidden mb-3 <%= "car-details-card-modal" if modal %>"
       data-controller="photo-lightbox<%= ' photo-variant-toggle' if variant_toggle_available %>"
       <% if variant_toggle_available %>
         data-photo-variant-toggle-ai-url-value="<%= display_photo_url %>"
         data-photo-variant-toggle-original-url-value="<%= original_photo_url %>"
         data-photo-variant-toggle-original-label-value="<%= t("cars.show.view_original_photo") %>"
         data-photo-variant-toggle-ai-label-value="<%= t("cars.show.view_ai_photo") %>"
       <% end %>>
    <% if display_photo_url.present? %>
      <button type="button"
              class="car-details-photo-button"
              data-action="click->photo-lightbox#open"
              aria-label="<%= t("cars.show.view_full_photo") %>">
        <%= image_tag display_photo_url,
                      style: "width: 100%; height: 100%; object-fit: cover; display: block;",
                      data: { "photo-variant-toggle-target": "image" } %>
        <div class="position-absolute bottom-0 end-0 m-3">
          <span class="badge bg-dark bg-opacity-60 rounded-3 px-3 py-2 text-white">
            <i class="bi bi-zoom-in me-1"></i> <%= t("cars.show.view_full_photo") %>
          </span>
        </div>
      </button>
      <% if variant_toggle_available %>
        <button type="button"
                class="position-absolute bottom-0 start-0 m-3 badge bg-light text-dark rounded-3 px-3 py-2 text-decoration-none shadow-sm border-0"
                data-action="click->photo-variant-toggle#toggle">
          <i class="bi bi-image me-1"></i>
          <span data-photo-variant-toggle-target="buttonLabel"><%= t("cars.show.view_original_photo") %></span>
        </button>
      <% end %>

      <div class="photo-lightbox-overlay d-none"
           data-photo-lightbox-target="overlay"
           data-action="click->photo-lightbox#close keydown@window->photo-lightbox#closeWithKeyboard"
           role="dialog"
           aria-modal="true"
           aria-label="<%= t("cars.show.view_full_photo") %>">
        <div class="photo-lightbox-stage" data-action="click->photo-lightbox#keepOpen">
          <%= image_tag display_photo_url,
                class: "photo-lightbox-image rounded-3 shadow-lg",
                alt: car.name.presence || t("cars.show.fallback_name"),
                data: { "photo-variant-toggle-target": "lightboxImage" } %>
          <button type="button"
                  class="btn btn-dark btn-sm rounded-circle shadow photo-lightbox-close"
                  data-action="click->photo-lightbox#close"
                  aria-label="<%= t('actions.close') %>">
            <i class="bi bi-x-lg small"></i>
          </button>
        </div>
      </div>
    <% else %>
      <div class="car-details-empty-photo bg-light d-flex align-items-center justify-content-center text-muted">
        <div class="text-center">
          <i class="bi bi-camera display-4 mb-2 opacity-30"></i>
          <p class="small mb-0"><%= t("cars.show.no_photo") %></p>
        </div>
      </div>
    <% end %>

    <div class="card-body <%= modal ? "p-3 p-md-4" : "p-4 p-md-5" %>">
      <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
        <div>
          <h1 class="<%= modal ? "h4" : "h2" %> fw-bold mb-1"><%= car.name.presence || t("cars.show.fallback_name") %></h1>
          <% if car.brand? %>
            <span class="badge bg-primary bg-opacity-10 text-primary fw-semibold fs-6 rounded-3"><%= car.brand %></span>
          <% end %>
        </div>
      </div>

      <hr class="my-3">

      <%= render "cars/metadata_badges",
                 car: car,
                 photo_upscaled_by_ai: display_photo_upscaled_by_ai,
                 badge_class: "text-muted small d-flex flex-wrap gap-3 mb-3",
                 item_class: "d-inline-flex align-items-center gap-1" %>

      <div class="row <%= modal ? "g-3" : "g-4" %> mb-3 car-details-stats">
        <div class="col-12">
          <div class="d-flex flex-column">
            <small class="text-uppercase fw-semibold text-muted tracking-wide mb-1"><%= t("activerecord.attributes.car.observations") %></small>
            <p class="mb-0 text-dark car-details-observations"><%= car.observations.presence || t("cars.show.fallback_name") %></p>
          </div>
        </div>
      </div>

      <div class="car-details-timestamps text-muted small border-top pt-3 mt-4">
        <div class="car-details-timestamp">
          <i class="bi bi-clock"></i>
          <span><%= t("cars.show.added_at", date: l(car.created_at.to_date, format: :numeric)) %></span>
        </div>
        <div class="car-details-timestamp">
          <i class="bi bi-arrow-repeat"></i>
          <span><%= t("cars.show.updated_at", date: l(car.updated_at, format: :short)) %></span>
        </div>
      </div>
    </div>
  </div>
<% end %>
</div>
