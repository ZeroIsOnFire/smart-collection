<% modal = local_assigns.fetch(:modal, false) %>

<%= simple_form_for(car, html: {
  class: "needs-validation",
  novalidate: true,
  multipart: true,
  data: {
    controller: "color-detector",
    "color-detector-colors-value": Car::COLORS.to_json,
    "color-detector-detect-url-value": detect_color_autodetections_path
  }
}) do |f| %>
  <%= f.error_notification %>

  <div class="<%= modal ? 'modal-form-shell' : 'card border-0 shadow-sm rounded-4 overflow-hidden mb-4' %>">
    <div class="<%= modal ? 'p-0' : 'card-body p-4 p-md-5' %>">

      <!-- Foto Principal -->
      <h5 class="fw-bold mb-4 text-dark pb-2 border-bottom">
        <i class="bi bi-camera me-2 text-primary"></i> <%= t('cars.form.main_photo') %>
      </h5>

      <div class="col-12 mb-5"
           data-controller="photo-upload image-cropper"
           data-image-cropper-detect-url-value="<%= classify_autodetections_path %>"
           data-action="dragover->photo-upload#dragOver dragleave->photo-upload#dragLeave drop->photo-upload#drop">

        <%= f.hidden_field :crop_x, data: { "image-cropper-target": "x" } %>
        <%= f.hidden_field :crop_y, data: { "image-cropper-target": "y" } %>
        <%= f.hidden_field :crop_w, data: { "image-cropper-target": "w" } %>
        <%= f.hidden_field :crop_h, data: { "image-cropper-target": "h" } %>

        <!-- Atributo para persistência do CarrierWave entre falhas de validação -->
        <%= f.hidden_field :photo_cache %>

        <!-- Hidden input for remove_photo -->
        <%= f.hidden_field :remove_photo, value: "", data: { "photo-upload-target": "removeField" } %>
        <%= f.hidden_field :remote_photo_url %>

        <!-- File input (hidden but accessible for programmatic .click()) -->
        <%= f.file_field :photo,
              accept: "image/png,image/gif,image/jpeg",
              style: "position: absolute; width: 0; height: 0; opacity: 0; overflow: hidden;",
              data: { "photo-upload-target": "input", "color-detector-target": "input", action: "change->photo-upload#fileSelected change->color-detector#detect" } %>

        <!-- Existing photo data (only on edit) -->
        <% if car.photo? %>
          <span data-photo-upload-target="existingPhoto"
                data-url="<%= car.photo.url %>"
                class="d-none"></span>
        <% elsif car.remote_photo_url.present? %>
          <span data-photo-upload-target="remotePhoto"
                data-url="<%= car.remote_photo_url %>"
                class="d-none"></span>
        <% end %>

        <!-- Drop zone / Upload prompt -->
        <div class="position-relative border rounded-4 p-5 text-center bg-light photo-dropzone"
             style="border-style: dashed !important; border-width: 2px !important; border-color: #dee2e6 !important; cursor: pointer;"
             data-photo-upload-target="dropzone"
             data-action="click->photo-upload#openFilePicker">

          <!-- Upload prompt (shown when no photo) -->
          <div data-photo-upload-target="uploadPrompt">
            <div class="d-inline-flex align-items-center justify-content-center bg-white shadow-sm rounded-circle mb-3"
                 style="width: 64px; height: 64px;">
              <i class="bi bi-cloud-upload text-primary fs-3"></i>
            </div>
            <h6 class="fw-bold text-dark mb-1"><%= t('cars.form.upload_prompt') %></h6>
            <p class="text-muted small mb-0"><%= t('cars.form.upload_limits') %></p>
            <%= render "shared/ai_upscaling_notice",
                       translation_key: "cars.form.ai_upscaling_notice",
                       minimum_side: ImageUpscalerService.default_minimum_side %>
            <div class="form-check form-switch d-inline-flex align-items-center gap-2 mt-3">
              <%= f.check_box :skip_upscaler, class: "form-check-input", role: "switch" %>
              <%= f.label :skip_upscaler, t("cars.form.skip_upscaler"), class: "form-check-label small text-muted" %>
            </div>
          </div>

          <!-- Preview (hidden initially, shown after photo selected or existing) -->
          <div data-photo-upload-target="preview" class="d-none">
            <div class="position-relative d-inline-block">
              <img data-photo-upload-target="previewImg"
                   data-image-cropper-target="previewImg"
                   src=""
                   alt="Preview"
                   class="rounded-3 shadow-sm"
                   style="max-height: 240px; max-width: 100%; object-fit: contain;">

              <button type="button"
                      class="btn btn-premium btn-sm rounded-circle position-absolute shadow"
                      style="top: -10px; right: 25px; width: 32px; height: 32px; padding: 0; line-height: 1;"
                      title="<%= t('cars.form.crop_button') %>"
                      data-action="click->image-cropper#open">
                <i class="bi bi-crop"></i>
              </button>

              <button type="button"
                      class="btn btn-danger btn-sm rounded-circle position-absolute shadow"
                      style="top: -10px; right: -10px; width: 32px; height: 32px; padding: 0; line-height: 1;"
                      title="<%= t('cars.form.remove_button') %>"
                      data-action="click->photo-upload#removePhoto">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>
            <p class="text-muted small mt-3 mb-0"><%= t('cars.form.replace_button') %></p>
          </div>
        </div>

        <!-- Modal de Cropper -->
        <div class="modal fade" id="cropperModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
          <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
              <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-crop me-2 text-primary"></i> <%= t('cars.form.adjust_photo') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body p-0">
                <div class="cropper-container-wrapper"
                     style="height: 450px; max-height: 70vh; background-color: #0f172a; position: relative;">
                  <img src="" data-image-cropper-target="image" class="img-fluid"
                       style="display: block; max-width: 100%; opacity: 0;">
                </div>
              </div>
              <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal"><%= t('actions.cancel') %></button>
                <button type="button" class="btn btn-premium rounded-pill px-4" data-action="click->image-cropper#save"><%= t('cars.form.save_crop') %></button>
              </div>
            </div>
          </div>
        </div>

        <% if car.errors[:photo].any? %>
          <div class="invalid-feedback d-block text-start mt-2">
            <%= car.errors[:photo].to_sentence %>
          </div>
        <% end %>
      </div>

      <!-- Informações Básicas -->
      <h5 class="fw-bold mb-4 text-dark pb-2 border-bottom">
        <i class="bi bi-box-seam me-2 text-primary"></i> <%= t('cars.form.basic_info') %>
      </h5>

      <div class="row g-4 mb-4">
        <div class="col-12">
          <%= f.input :brand,
                      placeholder: t("cars.form.brand_placeholder"),
                      input_html: { class: "form-control-lg bg-light border-0" },
                      label_html: { class: "text-secondary small text-uppercase tracking-wide" } %>
        </div>

        <div class="col-12">
          <%= f.input :name,
                      placeholder: t("cars.form.name_placeholder"),
                      input_html: { class: "form-control-lg bg-light border-0" },
                      label_html: { class: "text-secondary small text-uppercase tracking-wide" } %>
        </div>
      </div>

      <!-- Especificações -->
      <h5 class="fw-bold mb-4 text-dark pb-2 border-bottom">
        <i class="bi bi-sliders me-2 text-primary"></i> <%= t('cars.form.specifications') %>
      </h5>

      <div class="row g-4 mb-5">
        <div class="col-md-6">
          <%= f.input :year,
                      placeholder: t("cars.form.year_placeholder"),
                      input_html: { class: "form-control-lg bg-light border-0" },
                      label_html: { class: "text-secondary small text-uppercase tracking-wide" } %>
        </div>

        <div class="col-md-6">
          <%= f.input :size,
                      as: :select,
                      collection: Car.scale_options,
                      include_blank: t('cars.form.select_scale'),
                      input_html: { class: "form-select form-select-lg bg-light border-0" },
                      label_html: { class: "text-secondary small text-uppercase tracking-wide" } %>
        </div>

        <div class="col-md-12 mt-4">
          <%= f.input :color,
                      as: :select,
                      collection: Car.color_options,
                      include_blank: t('cars.form.select_color'),
                      input_html: {
                        class: "form-select form-select-lg bg-light border-0",
                        data: {
                          "color-detector-target": "select"
                        }
                      },
                      label_html: { class: "text-secondary small text-uppercase tracking-wide" } %>
          <small class="text-secondary small text-uppercase tracking-wide mt-2 d-block ms-1" style="font-size: 0.7rem;"><%= t('cars.form.predominant_color') %></small>
        </div>
      </div>

      <!-- Detalhes Adicionais -->
      <h5 class="fw-bold mb-4 text-dark pb-2 border-bottom">
        <i class="bi bi-card-text me-2 text-primary"></i> <%= t('activerecord.attributes.car.observations') %>
      </h5>

      <div class="row g-4 mb-2">
        <div class="col-12">
          <%= f.input :observations,
                      as: :text,
                      label: false,
                      placeholder: t("cars.form.observations_placeholder"),
                      input_html: { class: "bg-light border-0", rows: 4 },
                      label_html: { class: "text-secondary small text-uppercase tracking-wide" } %>
        </div>
      </div>

    </div>

    <div class="<%= modal ? 'pt-4 d-flex flex-column flex-sm-row justify-content-end align-items-stretch align-items-sm-center gap-2 border-top' : 'card-footer bg-light border-0 p-4 p-md-5 d-flex flex-column flex-md-row justify-content-between align-items-stretch align-items-md-center gap-3' %>">
      <div>
        <% if modal %>
          <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal"><%= t('actions.cancel') %></button>
        <% else %>
          <%= link_to cars_path, class: "btn btn-link text-secondary text-decoration-none fw-semibold px-0" do %>
            <i class="bi bi-arrow-left me-2"></i><%= t('actions.back') %>
          <% end %>
        <% end %>
      </div>

      <div class="d-flex flex-column flex-sm-row gap-2">
        <% unless car.persisted? %>
          <%= button_tag t('cars.form.create_another'),
                         type: :submit,
                         name: :commit_action,
                         value: :create_another,
                         class: modal ? "btn btn-outline-primary rounded-pill px-4 fw-bold" : "btn btn-outline-primary btn-lg rounded-pill px-4 fw-bold",
                         data: { disable_with: t('cars.form.create_another') } %>
        <% end %>

        <%= f.button :submit,
                     car.persisted? ? t('actions.save') : t('actions.create'),
                     class: modal ? "btn-primary rounded-pill px-4 fw-bold shadow-sm" : "btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm" %>
      </div>
    </div>
  </div>
<% end %>

<style>
  .tracking-wide { letter-spacing: 0.05em; }
  .form-control { transition: all 0.2s ease-in-out; }
  .form-control:focus {
    background-color: var(--input-bg) !important;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1) !important;
    border: 1px solid var(--premium-indigo) !important;
  }
  .photo-dropzone {
    transition: all 0.2s ease-in-out;
  }
  .photo-dropzone:hover {
    background-color: var(--soft-secondary-bg) !important;
    border-color: var(--border-color) !important;
  }
  .photo-dropzone.drag-over {
    background-color: var(--soft-secondary-bg) !important;
    border-color: var(--premium-indigo) !important;
    opacity: 0.8;
  }

  /* Cropper Customization */
  .cropper-view-box, .cropper-face {
    border-radius: 4px;
  }
  .cropper-line, .cropper-point {
    background-color: var(--premium-indigo);
  }
  .cropper-container-wrapper .cropper-container {
    width: 100% !important;
    height: 100% !important;
  }
</style>
