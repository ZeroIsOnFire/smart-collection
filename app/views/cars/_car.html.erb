<% car_dom_id = car.id.to_s %>

<div id="car_<%= car_dom_id %>" class="col animate-fade-in car-card-wrapper" data-car-card-id="<%= car_dom_id %>">
  <% cache [car, I18n.locale, local_assigns[:public], :card_actions_v4] do %>
    <div class="card premium-card h-100 shadow-sm border-0 position-relative rounded-4 overflow-hidden" style="transition: transform 0.2s ease, box-shadow 0.2s ease;">
      <% unless local_assigns[:public] %>
        <!-- Menu Dropdown (Hiden on public views) -->
        <div class="position-absolute top-0 end-0 p-2 z-3 car-action-dropdown">
          <div class="dropdown">
            <button class="btn btn-sm bg-white bg-opacity-90 rounded-circle shadow-sm border-0"
                    type="button" data-bs-toggle="dropdown" aria-expanded="false"
                    style="width: 32px; height: 32px; padding: 0;">
              <i class="bi bi-three-dots-vertical small"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
              <li>
                <%= link_to car_path(car), class: 'dropdown-item d-flex align-items-center gap-2 py-2', data: { turbo_frame: "modal" } do %>
                  <i class="bi bi-eye text-muted"></i> <%= t("cars.card.view_details") %>
                <% end %>
              </li>
              <li>
                <%= link_to edit_car_path(car), class: 'dropdown-item d-flex align-items-center gap-2 py-2', data: { turbo_frame: "modal" } do %>
                  <i class="bi bi-pencil text-muted"></i> <%= t("actions.edit") %>
                <% end %>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= button_to car_path(car),
                              method: :delete,
                              form: {
                                data: {
                                  "car-removal-car-id": car_dom_id
                                }
                              },
                              data: {
                                car_removal_trigger: true,
                                car_removal_car_id: car_dom_id,
                                car_removal_confirm_message: t('items.delete_confirm')
                              },
                              class: 'dropdown-item text-danger d-flex align-items-center gap-2 py-2' do %>
                  <i class="bi bi-trash3"></i> <%= t("actions.delete") %>
                <% end %>
              </li>
            </ul>
          </div>
        </div>
      <% end %>

      <%# Detalhe: se for público, usamos o path do share, senão o path normal %>
      <% target_path = local_assigns[:public] ? public_share_car_path(share_token: local_assigns[:user].share_token, id: car.id) : car_path(car) %>
      <%= link_to target_path, class: "text-decoration-none", data: { turbo_frame: "modal" } do %>
        <!-- Foto -->
        <% if car.photo? %>
          <div class="car-photo-container position-relative" style="height: 180px; overflow: hidden;">
            <%= image_tag car.photo.url, loading: "lazy", style: car_card_photo_style(car) %>
            <% if car.photo_processing? %>
              <div class="position-absolute top-0 start-0 end-0 bottom-0 d-flex align-items-center justify-content-center bg-dark bg-opacity-50 text-white small fw-semibold">
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span class="car-photo-processing-label"><%= t("cars.card.photo_processing") %></span>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="car-photo-container bg-light d-flex align-items-center justify-content-center text-muted" style="height: 180px;">
            <div class="text-center">
              <i class="bi bi-camera fs-3 opacity-30 d-block mb-1"></i>
              <small class="opacity-50"><%= t("cars.card.no_photo") %></small>
            </div>
          </div>
        <% end %>

        <!-- Corpo do Card -->
        <div class="card-body px-3 pb-3 pt-2">
          <h5 class="card-title mb-0 fw-bold text-dark text-truncate fs-6"><%= car.name.presence || '—' %></h5>

          <!-- Marca -->
          <div class="d-flex flex-wrap gap-1 mt-1 mb-2">
            <% if car.brand? %>
              <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary small fw-normal"><%= car.brand %></span>
            <% end %>
          </div>

          <!-- Ano + Escala + Cor -->
          <%= render "cars/metadata_badges", car: car %>
        </div>
      <% end %>

      <div class="car-removal-loader" aria-hidden="true">
        <div class="spinner-border text-primary" role="status">
          <span class="visually-hidden"><%= t("javascript.modal.loading") %></span>
        </div>
      </div>
    </div>
  <% end %>
</div>
