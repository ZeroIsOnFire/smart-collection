<turbo-frame id="detected_item_<%= detected_item.id %>"
             class="col-12 mb-4 d-block"
             data-controller="detected-item"
             data-detected-item-loading-label-value="<%= t('autodetections.messages.saving') %>">
  <%
    form_car = local_assigns.fetch(:car, Car.new)
    has_form_errors = form_car.errors.any?
    is_saved = detected_item.status == 'saved'
    is_rejected = detected_item.status == 'rejected'
    is_processed = is_saved || is_rejected
    is_image_processing = detected_item.image_processing?
  %>

  <% cache [detected_item, form_car.errors.details, form_car.attributes.slice('brand', 'name', 'color', 'year', 'size'), form_car.year_before_type_cast] do %>
  <div class="card shadow-sm rounded-4 border-0 overflow-hidden position-relative detected-item-card <%= 'is-processed' if is_processed %>">
    <!-- Loading Overlay -->
    <div class="detected-item-loader">
      <div class="detected-item-loader-content">
        <div class="spinner-border text-primary" role="status">
          <span class="visually-hidden"><%= t('autodetections.messages.saving') %></span>
        </div>
        <span class="detected-item-loader-label"><%= t('autodetections.messages.saving') %></span>
      </div>
    </div>
    <div class="card-body p-0">
      <div class="row g-0 align-items-stretch">

        <!-- Lado Esquerdo: Foto (25%) -->
        <div class="col-md-3 detected-item-photo-col border-end">
          <% if detected_item.cropped_photo? %>
            <%= image_tag detected_item.cropped_photo.url,
                          loading: "lazy",
                          class: "img-fluid w-100 h-100 object-fit-cover",
                          style: "min-height: 220px;" %>
          <% else %>
            <div class="d-flex align-items-center justify-content-center bg-soft-secondary w-100" style="min-height: 220px;">
              <i class="bi bi-camera display-4 text-muted opacity-25"></i>
            </div>
          <% end %>
        </div>

        <!-- Centro: Formulário ou Status (50%) -->
        <div class="col-md-6 p-4 d-flex flex-column justify-content-center">
          <% if is_image_processing %>
            <div class="animate-fade-in">
              <div class="d-flex align-items-center mb-2">
                <div class="icon-box bg-primary bg-opacity-10 rounded-circle me-3 text-primary" style="width: 45px; height: 45px; margin-bottom: 0;">
                  <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                </div>
                <h5 class="fw-bold mb-0 text-primary"><%= t('autodetections.detected_item.statuses.processing_title') %></h5>
              </div>
              <p class="mb-0 text-muted ps-5"><%= t('autodetections.detected_item.statuses.processing_text') %></p>
            </div>
          <% elsif detected_item.image_processing_status == 'error' %>
            <div class="animate-fade-in">
              <div class="d-flex align-items-center mb-2">
                <div class="icon-box bg-soft-danger rounded-circle me-3" style="width: 45px; height: 45px; margin-bottom: 0;">
                  <i class="bi bi-exclamation-triangle"></i>
                </div>
                <h5 class="fw-bold mb-0 text-danger"><%= t('autodetections.detected_item.statuses.processing_error_title') %></h5>
              </div>
              <p class="mb-0 text-muted ps-5"><%= t('autodetections.detected_item.statuses.processing_error_text') %></p>
            </div>
          <% elsif is_saved %>
            <div class="animate-fade-in">
              <div class="d-flex align-items-center mb-2">
                <div class="icon-box bg-emerald-light rounded-circle me-3" style="width: 45px; height: 45px; margin-bottom: 0;">
                  <i class="bi bi-check-lg"></i>
                </div>
                <h5 class="fw-bold mb-0 text-success"><%= t('autodetections.detected_item.statuses.saved_title') %></h5>
              </div>
              <p class="mb-0 text-muted ps-5"><%= t('autodetections.detected_item.statuses.saved_text') %></p>
            </div>
          <% elsif is_rejected %>
            <div class="animate-fade-in">
              <div class="d-flex align-items-center mb-2">
                <div class="icon-box bg-soft-danger rounded-circle me-3" style="width: 45px; height: 45px; margin-bottom: 0;">
                  <i class="bi bi-x-lg"></i>
                </div>
                <h5 class="fw-bold mb-0 text-danger"><%= t('autodetections.detected_item.statuses.rejected_title') %></h5>
              </div>
              <p class="mb-0 text-muted ps-5"><%= t('autodetections.detected_item.statuses.rejected_text') %></p>
            </div>
          <% else %>
            <%= simple_form_for(form_car, url: cars_path, html: { id: "form_detected_item_#{detected_item.id}", class: "row g-3 detected-item-form" }) do |f| %>
              <%= hidden_field_tag :detected_item_id, detected_item.id %>

              <div class="col-12">
                <%= f.input :brand,
                            label: t('autodetections.detected_item.brand_optional'),
                            error: field_error_message(form_car, :brand),
                            input_html: { value: has_form_errors ? form_car.brand : detected_item.brand, id: "brand_#{detected_item.id}", class: "bg-light border-0" },
                            label_html: { class: "text-secondary small text-uppercase tracking-wide", for: "brand_#{detected_item.id}" } %>
              </div>

              <div class="col-12">
                <%= f.input :name,
                            label: t('autodetections.detected_item.model_required'),
                            required: true,
                            error: field_error_message(form_car, :name),
                            input_html: { value: has_form_errors ? form_car.name : detected_item.label, id: "name_#{detected_item.id}", class: "bg-light border-0 fw-bold" },
                            label_html: { class: "text-secondary small text-uppercase tracking-wide", for: "name_#{detected_item.id}" } %>
              </div>

              <div class="col-md-5">
                <%= f.input :color,
                            as: :select,
                            collection: Car.color_options,
                            selected: has_form_errors ? form_car.color : detected_item.color,
                            include_blank: t('autodetections.detected_item.select_prompt'),
                            label: t('autodetections.detected_item.color'),
                            error: field_error_message(form_car, :color),
                            input_html: { id: "color_#{detected_item.id}", class: "form-select bg-light border-0" },
                            label_html: { class: "text-secondary small text-uppercase tracking-wide", for: "color_#{detected_item.id}" } %>
              </div>

              <div class="col-md-3">
                <%= f.input :year,
                            label: t('autodetections.detected_item.year'),
                            error: field_error_message(form_car, :year),
                            input_html: {
                              value: has_form_errors ? form_car.year_before_type_cast : detected_item.year,
                              id: "year_#{detected_item.id}",
                              class: "bg-light border-0",
                              data: {
                                controller: "numeric-mask",
                                action: "input->numeric-mask#sanitize"
                              }
                            },
                            label_html: { class: "text-secondary small text-uppercase tracking-wide", for: "year_#{detected_item.id}" } %>
              </div>

              <div class="col-md-4">
                <%= f.input :size,
                            as: :select,
                            collection: Car.scale_options,
                            selected: has_form_errors ? form_car.size : detected_item.size,
                            include_blank: t('autodetections.detected_item.select_prompt'),
                            label: t('autodetections.detected_item.size_scale'),
                            error: field_error_message(form_car, :size),
                            input_html: { id: "size_#{detected_item.id}", class: "form-select bg-light border-0" },
                            label_html: { class: "text-secondary small text-uppercase tracking-wide", for: "size_#{detected_item.id}" } %>
              </div>
            <% end %>
          <% end %>
        </div>

        <!-- Direita: Ações (25%) -->
        <div class="col-md-3 detected-item-actions-col">
          <% if is_image_processing %>
            <div class="d-grid gap-3 w-100">
              <button type="button" class="btn btn-soft-secondary w-100 rounded-pill py-3" disabled>
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span><%= t('autodetections.detected_item.statuses.processing_title') %>
              </button>
            </div>
          <% elsif is_saved || is_rejected %>
             <%= button_to undo_detected_item_path(detected_item),
                  method: :patch,
                  class: "btn btn-soft-secondary w-100 rounded-pill py-2 border-0 shadow-sm",
                  data: { turbo_frame: "detected_item_#{detected_item.id}" } do %>
                <i class="bi bi-arrow-counterclockwise me-2"></i><%= t('autodetections.detected_item.undo') %>
             <% end %>
          <% else %>
            <div class="d-grid gap-3 w-100">
              <button type="submit"
                      form="form_detected_item_<%= detected_item.id %>"
                      class="btn btn-premium w-100 rounded-pill py-3"
                      data-detected-item-target="submit"
                      data-loading-html="<span class='spinner-border spinner-border-sm me-2' role='status' aria-hidden='true'></span><%= t('autodetections.messages.saving') %>">
                <i class="bi bi-check2-circle fs-5 me-2"></i><span><%= t('autodetections.detected_item.save_item') %></span>
              </button>

              <button type="button"
                      class="btn btn-soft-secondary w-100 rounded-pill py-2"
                      data-action="click->detected-item#openAdjustmentModal">
                <i class="bi bi-crop me-2"></i><%= t('autodetections.detected_item.adjust_selection') %>
              </button>

              <%= button_to reject_detected_item_path(detected_item),
                    method: :patch,
                    class: "btn btn-soft-danger w-100 rounded-pill py-2",
                    data: { turbo_frame: "detected_item_#{detected_item.id}" } do %>
                <i class="bi bi-trash3 me-2"></i><%= t('autodetections.detected_item.discard') %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>


  <!-- Modal de Ajuste de Seleção (Cropper) -->
  <div class="modal fade" id="adjustmentModal_<%= detected_item.id %>" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <%
        # Calcular coordenadas iniciais para o cropper baseadas no position_data
        vertices = detected_item.position_data["vertices"] || []
        xs = vertices.map { |v| (v["x"] || v[:x] || 0).to_f }
        ys = vertices.map { |v| (v["y"] || v[:y] || 0).to_f }
        min_x = xs.min || 0
        min_y = ys.min || 0
        w = (xs.max || 0) - min_x
        h = (ys.max || 0) - min_y
      %>
      <div class="modal-content border-0 shadow-lg rounded-4"
           data-controller="selection-adjustment"
           data-selection-adjustment-initial-x-value="<%= min_x %>"
           data-selection-adjustment-initial-y-value="<%= min_y %>"
           data-selection-adjustment-initial-width-value="<%= w %>"
           data-selection-adjustment-initial-height-value="<%= h %>"
           data-selection-adjustment-update-url-value="<%= update_selection_detected_item_path(detected_item) %>"
           data-selection-adjustment-item-id-value="<%= detected_item.id %>"
           data-selection-adjustment-loading-text-value="<%= t('autodetections.messages.saving') %>"
           data-selection-adjustment-save-error-text-value="<%= t('autodetections.messages.item_error') %>"
           data-selection-adjustment-unexpected-error-text-value="<%= t('flash.error') %>">

        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold"><i class="bi bi-crop me-2 text-primary"></i> <%= t('autodetections.detected_item.adjust_selection') %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body p-0">
          <div class="cropper-container-wrapper"
               style="height: 450px; max-height: 70vh; background-color: #0f172a; position: relative;">
            <img src="<%= detected_item.autodetection.photo.url %>"
                 data-selection-adjustment-target="image"
                 class="img-fluid"
                 style="display: block; max-width: 100%; opacity: 0;">
          </div>
        </div>

        <div class="modal-footer border-0 p-4 pt-0">
          <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal"><%= t('actions.cancel') %></button>
          <button type="button" class="btn btn-premium rounded-pill px-4" data-action="click->selection-adjustment#save"><%= t('autodetections.detected_item.confirm_adjustment') %></button>
        </div>
      </div>
    </div>
  </div>
  <% end %>
</turbo-frame>
