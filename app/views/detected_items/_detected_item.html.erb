<turbo-frame id="detected_item_<%= detected_item.id %>"
             class="col-12 mb-4 d-block"
             data-controller="detected-item">
  <% cache detected_item do %>
  <%
    is_saved = detected_item.status == 'saved'
    is_rejected = detected_item.status == 'rejected'
    is_processed = is_saved || is_rejected
  %>

  <div class="card shadow rounded-4 border-0 overflow-hidden position-relative
              <%= 'bg-light opacity-75' if is_processed %>">

    <!-- Loading Overlay -->
    <div class="detected-item-loader">
      <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Enviando...</span>
      </div>
    </div>
    <div class="card-body p-0">
      <div class="row g-0 align-items-center">

        <!-- Lado Esquerdo: Foto (25%) -->
        <div class="col-md-3 bg-light border-end">
          <% if detected_item.cropped_photo? %>
            <%= image_tag detected_item.cropped_photo.url,
                          loading: "lazy",
                          class: "img-fluid w-100 object-fit-cover",
                          style: "height: 200px;" %>
          <% else %>
            <div class="d-flex align-items-center justify-content-center bg-white" style="height: 200px;">
              <i class="bi bi-camera display-4 text-muted"></i>
            </div>
          <% end %>
        </div>

        <!-- Centro: Formulário ou Status (55%) -->
        <div class="col-md-6 p-4">
          <% if is_saved %>
            <div class="d-flex align-items-center h-100">
              <div class="text-success">
                <h5 class="fw-bold mb-1"><i class="bi bi-check-circle-fill me-2"></i> <%= t('autodetections.detected_item.statuses.saved_title') %></h5>
                <p class="mb-0 text-muted"><%= t('autodetections.detected_item.statuses.saved_text') %></p>
              </div>
            </div>
          <% elsif is_rejected %>
            <div class="d-flex align-items-center h-100">
              <div class="text-danger">
                <h5 class="fw-bold mb-1"><i class="bi bi-x-circle-fill me-2"></i> <%= t('autodetections.detected_item.statuses.rejected_title') %></h5>
                <p class="mb-0 text-muted"><%= t('autodetections.detected_item.statuses.rejected_text') %></p>
              </div>
            </div>
          <% else %>
            <%= form_with model: Car.new, url: cars_path, id: "form_detected_item_#{detected_item.id}", class: "row g-3" do |f| %>
              <%= hidden_field_tag :detected_item_id, detected_item.id %>

              <div class="col-md-6">
                <div class="form-floating">
                  <%= f.text_field :brand,
                        value: detected_item.brand,
                        class: "form-control border-0 bg-light",
                        id: "brand_#{detected_item.id}",
                        placeholder: "Hot Wheels" %>
                  <label for="brand_<%= detected_item.id %>"><%= t('autodetections.detected_item.brand_optional') %></label>
                </div>
              </div>

              <div class="col-md-6">
                <div class="form-floating">
                  <%= f.text_field :manufacturer,
                        value: detected_item.manufacturer,
                        class: "form-control border-0 bg-light",
                        id: "manufacturer_#{detected_item.id}",
                        placeholder: "Porsche" %>
                  <label for="manufacturer_<%= detected_item.id %>"><%= t('autodetections.detected_item.manufacturer_optional') %></label>
                </div>
              </div>

              <div class="col-12 mb-2">
                <div class="form-floating">
                  <%= f.text_field :name,
                        value: detected_item.label,
                        class: "form-control border-0 bg-light fw-bold",
                        id: "name_#{detected_item.id}",
                        placeholder: "911 Carrera",
                        required: true %>
                  <label for="name_<%= detected_item.id %>"><%= t('autodetections.detected_item.model_required') %></label>
                </div>
              </div>

              <div class="col-md-4">
                <div class="form-floating">
                  <%= f.select :color,
                        Car.color_options,
                        { selected: detected_item.color, prompt: t('autodetections.detected_item.select_prompt') },
                        { class: "form-select border-0 bg-light", id: "color_#{detected_item.id}" } %>
                  <label for="color_<%= detected_item.id %>"><%= t('autodetections.detected_item.color') %></label>
                </div>
              </div>

              <div class="col-md-4">
                <div class="form-floating">
                  <%= f.text_field :year,
                        value: detected_item.year,
                        class: "form-control border-0 bg-light",
                        id: "year_#{detected_item.id}",
                        placeholder: "1998" %>
                  <label for="year_<%= detected_item.id %>"><%= t('autodetections.detected_item.year') %></label>
                </div>
              </div>

              <div class="col-md-4">
                <div class="form-floating">
                  <%= f.select :size,
                        Car.scale_options,
                        { selected: detected_item.size, prompt: t('autodetections.detected_item.select_prompt') },
                        { class: "form-select border-0 bg-light", id: "size_#{detected_item.id}" } %>
                  <label for="size_<%= detected_item.id %>"><%= t('autodetections.detected_item.size_scale') %></label>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>

        <!-- Direita: Ações (20%) -->
        <div class="col-md-3 border-start p-4 bg-light d-flex flex-column gap-3 justify-content-center h-100 min-h-200">
          <% if is_saved || is_rejected %>
             <%= button_to undo_detected_item_path(detected_item),
                  method: :patch,
                  class: "btn btn-soft-secondary w-100 rounded-pill py-2",
                  data: { turbo_frame: "detected_item_#{detected_item.id}" } do %>
                <i class="bi bi-arrow-counterclockwise me-2"></i><%= t('autodetections.detected_item.undo') %>
             <% end %>
          <% else %>
            <div class="d-grid gap-2 w-100">
              <button type="submit" form="form_detected_item_<%= detected_item.id %>" class="btn btn-premium w-100 rounded-pill py-2 shadow-sm">
                <i class="bi bi-check2-circle me-2"></i><%= t('autodetections.detected_item.save_item') %>
              </button>

              <!-- Botão de Ajustar Seleção (Abre modal Cropper) -->
              <button type="button"
                      class="btn btn-soft-secondary w-100 rounded-pill py-2"
                      data-action="click->detected-item#openAdjustmentModal">
                <i class="bi bi-crop me-2"></i><%= t('autodetections.detected_item.adjust_selection') %>
              </button>

              <%= button_to reject_detected_item_path(detected_item),
                    method: :patch,
                    class: "btn btn-soft-danger w-100 rounded-pill py-2",
                    data: { turbo_frame: "detected_item_#{detected_item.id}", action: "click->detected-item#showLoading" } do %>
                <i class="bi bi-trash3 me-2"></i><%= t('autodetections.detected_item.discard') %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de Ajuste de Seleção (Cropper) -->
  <div class="modal fade" id="adjustmentModal_<%= detected_item.id %>" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <%
        # Calcular coordenadas iniciais para o cropper baseadas no position_data
        vertices = detected_item.position_data["vertices"] || []
        xs = vertices.map { |v| (v["x"] || v[:x] || 0).to_f }
        ys = vertices.map { |v| (v["y"] || v[:y] || 0).to_f }
        min_x = xs.min || 0
        min_y = ys.min || 0
        w = (xs.max || 0) - min_x
        h = (ys.max || 0) - min_y
      %>
      <div class="modal-content border-0 shadow-lg rounded-4"
           data-controller="selection-adjustment"
           data-selection-adjustment-initial-x-value="<%= min_x %>"
           data-selection-adjustment-initial-y-value="<%= min_y %>"
           data-selection-adjustment-initial-width-value="<%= w %>"
           data-selection-adjustment-initial-height-value="<%= h %>"
           data-selection-adjustment-update-url-value="<%= update_selection_detected_item_path(detected_item) %>"
           data-selection-adjustment-item-id-value="<%= detected_item.id %>"
           data-selection-adjustment-loading-text-value="<%= t('autodetections.messages.saving') %>"
           data-selection-adjustment-save-error-text-value="<%= t('autodetections.messages.item_error') %>"
           data-selection-adjustment-unexpected-error-text-value="<%= t('flash.error') %>">
        
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold"><i class="bi bi-crop me-2 text-primary"></i> <%= t('autodetections.detected_item.adjust_selection') %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        
        <div class="modal-body p-0">
          <div class="cropper-container-wrapper" 
               style="height: 450px; max-height: 70vh; background-color: #0f172a; position: relative;">
            <img src="<%= detected_item.autodetection.photo.url %>"
                 data-selection-adjustment-target="image"
                 class="img-fluid"
                 style="display: block; max-width: 100%; opacity: 0;">
          </div>
        </div>

        <div class="modal-footer border-0 p-4 pt-0">
          <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal"><%= t('actions.cancel') %></button>
          <button type="button" class="btn btn-premium rounded-pill px-4" data-action="click->selection-adjustment#save"><%= t('autodetections.detected_item.confirm_adjustment') %></button>
        </div>
      </div>
    </div>
  </div>
  <% end %>
</turbo-frame>
