<!DOCTYPE html>
<html data-controller="theme car-removal">
  <head>
    <title>Smart Collection</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-cache-control" content="no-preview">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= render "shared/javascript_i18n" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <link rel="icon" type="image/png" href="/logo/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/logo/favicon.svg" />
    <link rel="shortcut icon" href="/logo/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/logo/apple-touch-icon.png" />
    <link rel="manifest" href="/logo/site.webmanifest" />
    <script nonce="<%= content_security_policy_nonce %>">
      (function() {
        const savedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = savedTheme || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>

  <body>
    <%= render 'shared/flash_toasts' %>

    <header class="navbar navbar-expand-lg sticky-top border-bottom py-3">
      <div class="container-fluid app-container">
        <%= link_to root_path, class: "navbar-brand d-flex align-items-center" do %>
          <%= image_tag "/logo/logo.png", alt: "Smart Collection", height: 32, class: "me-2 theme-logo", data: { theme_target: "logo", dark_src: "/logo/logo-dark.png", light_src: "/logo/logo.png" } %>
          <span class="fw-bold tracking-tight">Smart<span class="text-primary">Collection</span></span>
        <% end %>

        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">
          <ul class="navbar-nav me-auto">
            <% if user_signed_in? %>
              <li class="nav-item">
                <%= link_to cars_path, class: "nav-link fw-medium d-flex align-items-center" do %>
                  <i class="bi bi-grid-1x2 me-2 text-primary"></i> <%= t('nav.my_cars') %>
                <% end %>
              </li>
            <% end %>
          </ul>

          <div class="d-flex align-items-center gap-2">
            <!-- Theme Toggle -->
            <button class="btn btn-link text-decoration-none p-2 rounded-circle hover-bg-light theme-toggle-btn"
                    data-action="click->theme#toggle"
                    title="Alternar tema">
              <i class="bi bi-moon-stars-fill fs-5" data-theme-target="icon"></i>
            </button>

            <div class="vr mx-1 opacity-10"></div>

            <div class="d-flex align-items-center gap-3">
            <% if user_signed_in? %>
              <!-- User Dropdown with Initials -->
              <div class="dropdown">
                <button class="btn border-0 p-0 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <div class="user-initials-avatar shadow-sm" style="background-color: <%= user_avatar_color(current_user) %>">
                    <%= user_initials(current_user) %>
                  </div>
                  <i class="bi bi-chevron-down small text-muted"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 mt-3 py-2" style="min-width: 220px;">
                  <li class="px-3 py-2">
                    <div class="fw-bold text-dark text-truncate">
                      <%= display_name(current_user) %>
                    </div>
                    <div class="text-muted extra-small"><%= current_user.email %></div>
                  </li>
                  <li>
                    <%= link_to cars_path, class: "dropdown-item d-flex align-items-center py-2" do %>
                      <i class="bi bi-grid-1x2 me-2 text-primary"></i> <%= t('nav.my_cars') %>
                    <% end %>
                  </li>
                  <% if current_user.admin? %>
                    <li>
                      <%= link_to admin_dashboard_path, class: "dropdown-item d-flex align-items-center py-2 text-warning" do %>
                        <i class="bi bi-shield-lock me-2"></i> <%= t('nav.admin_panel') %>
                      <% end %>
                    </li>
                  <% end %>
                  <li>
                    <%= link_to edit_user_registration_path, class: "dropdown-item d-flex align-items-center py-2" do %>
                      <i class="bi bi-gear me-2 text-secondary"></i> <%= t('nav.settings') %>
                    <% end %>
                  </li>
                  <li><hr class="dropdown-divider opacity-50"></li>
                  <li>
                    <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item d-flex align-items-center py-2 text-danger" do %>
                      <i class="bi bi-box-arrow-right me-2"></i> <%= t('nav.sign_out') %>
                    <% end %>
                  </li>
                </ul>
              </div>
            <% else %>
              <%= link_to t('nav.sign_in'), new_user_session_path, class: "btn btn-link link-dark text-decoration-none fw-medium" %>
              <%= link_to t('nav.sign_up'), new_user_registration_path, class: "btn btn-primary rounded-pill px-4" %>
            <% end %>
          </div>
        </div>
      </div>
    </header>

    <main>
      <%# Removemos as flash messages daqui pois agora estão nos Toasts %>
      <%= yield %>
    </main>

    <%= turbo_frame_tag "modal", data: { controller: "modal-frame" } %>


    <style>
      .user-initials-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.9rem;
        transition: transform 0.2s ease;
      }
      .user-initials-avatar:hover {
        transform: scale(1.05);
      }
      .dropdown-item:active {
        background-color: var(--bs-primary);
      }
      .extra-small {
        font-size: 0.75rem;
      }
    </style>
  </body>
</html>
