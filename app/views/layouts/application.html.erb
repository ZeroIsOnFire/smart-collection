<!DOCTYPE html>
<html>
  <head>
    <title>Smart Collection</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-cache-control" content="no-preview">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render 'shared/flash_toasts' %>

    <header class="navbar navbar-expand-lg navbar-light bg-white sticky-top border-bottom py-3">
      <div class="container-fluid app-container">
        <%= link_to root_path, class: "navbar-brand d-flex align-items-center" do %>
          <i class="bi bi-intersect text-primary fs-3 me-2"></i>
          <span class="fw-bold tracking-tight">Smart<span class="text-primary">Collection</span></span>
        <% end %>

        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">
          <ul class="navbar-nav me-auto">
            <!-- Espaço reservado para links futuros, se necessário -->
          </ul>
          
          <div class="d-flex align-items-center gap-3">
            <% if user_signed_in? %>
              <!-- User Dropdown with Initials -->
              <div class="dropdown">
                <button class="btn border-0 p-0 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <div class="user-initials-avatar shadow-sm" style="background-color: <%= user_avatar_color(current_user) %>">
                    <%= user_initials(current_user) %>
                  </div>
                  <i class="bi bi-chevron-down small text-muted"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 mt-3 py-2" style="min-width: 220px;">
                  <li class="px-3 py-2">
                    <div class="fw-bold text-dark text-truncate">
                      <%= display_name(current_user) %>
                    </div>
                    <div class="text-muted extra-small"><%= current_user.email %></div>
                  </li>
                  <li>
                    <%= link_to cars_path, class: "dropdown-item d-flex align-items-center py-2" do %>
                      <i class="bi bi-grid-1x2 me-2 text-primary"></i> Meus Carros
                    <% end %>
                  </li>
                  <% if current_user.admin? %>
                    <li>
                      <%= link_to admin_dashboard_path, class: "dropdown-item d-flex align-items-center py-2 text-warning" do %>
                        <i class="bi bi-shield-lock me-2"></i> Painel Admin
                      <% end %>
                    </li>
                  <% end %>
                  <li>
                    <%= link_to edit_user_registration_path, class: "dropdown-item d-flex align-items-center py-2" do %>
                      <i class="bi bi-gear me-2 text-secondary"></i> Configurações
                    <% end %>
                  </li>
                  <li><hr class="dropdown-divider opacity-50"></li>
                  <li>
                    <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item d-flex align-items-center py-2 text-danger" do %>
                      <i class="bi bi-box-arrow-right me-2"></i> Sair
                    <% end %>
                  </li>
                </ul>
              </div>
            <% else %>
              <%= link_to "Entrar", new_user_session_path, class: "btn btn-link link-dark text-decoration-none fw-medium" %>
              <%= link_to "Criar conta", new_user_registration_path, class: "btn btn-primary rounded-pill px-4" %>
            <% end %>
          </div>
        </div>
      </div>
    </header>

    <main>
      <%# Removemos as flash messages daqui pois agora estão nos Toasts %>
      <%= yield %>
    </main>


    <style>
      .user-initials-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.9rem;
        transition: transform 0.2s ease;
      }
      .user-initials-avatar:hover {
        transform: scale(1.05);
      }
      .dropdown-item:active {
        background-color: var(--bs-primary);
      }
      .extra-small {
        font-size: 0.75rem;
      }
    </style>
  </body>
</html>
