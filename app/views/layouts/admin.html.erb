<!DOCTYPE html>
<html data-controller="theme">
  <head>
    <title>Smart Collection - Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= render "shared/javascript_i18n" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <link rel="icon" type="image/png" href="/logo/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/logo/favicon.svg" />
    <link rel="shortcut icon" href="/logo/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/logo/apple-touch-icon.png" />
    <link rel="manifest" href="/logo/site.webmanifest" />
    <script>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = savedTheme || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>

  <body class="admin-body">
    <%= render 'shared/flash_toasts' %>

    <div class="d-flex min-vh-100">
      <!-- Sidebar -->
      <aside class="admin-sidebar bg-dark text-white d-flex flex-column">
        <div class="p-4 border-bottom border-secondary mb-3">
          <%= link_to admin_dashboard_path, class: "text-white text-decoration-none d-flex align-items-center gap-2" do %>
            <%= image_tag "/logo/logo-dark.png", alt: "SCC Admin", height: 32, class: "theme-logo", style: "mix-blend-mode: lighten;" %>
            <span class="fw-bold fs-5 tracking-tight">Admin</span>
          <% end %>
        </div>

        <nav class="flex-grow-1 px-3">
          <ul class="nav nav-pills flex-column gap-2">
            <li class="nav-item">
              <%= link_to admin_dashboard_path, class: "nav-link text-white #{'active' if controller_name == 'dashboard'}" do %>
                <i class="bi bi-speedometer2 me-2"></i> Dashboard
              <% end %>
            </li>
            <li class="nav-item">
              <%= link_to admin_users_path, class: "nav-link text-white #{'active' if controller_name == 'users'}" do %>
                <i class="bi bi-people me-2"></i> Usuários
              <% end %>
            </li>
            <li class="nav-item">
              <%= link_to admin_maintenance_path, class: "nav-link text-white #{'active' if controller_name == 'maintenance'}" do %>
                <i class="bi bi-tools me-2"></i> Manutenção
              <% end %>
            </li>
          </ul>
        </nav>

        <div class="p-3 border-top border-secondary">
          <div class="d-flex align-items-center gap-2 mb-3 px-2">
            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm text-white fw-bold" 
                 style="width: 32px; height: 32px; font-size: 0.8rem; background-color: <%= user_avatar_color(current_user) %>">
              <%= user_initials(current_user) %>
            </div>
            <div class="small text-truncate" style="max-width: 150px;"><%= display_name(current_user) %></div>
          </div>
          <div class="px-2 mb-3">
            <button class="btn btn-outline-light btn-sm w-100 rounded-pill d-flex align-items-center justify-content-center gap-2" data-action="click->theme#toggle">
              <i class="bi bi-moon-stars-fill" data-theme-target="icon"></i>
              <span>Alternar Tema</span>
            </button>
          </div>
          <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "btn btn-outline-danger btn-sm w-100 rounded-pill" do %>
            <i class="bi bi-box-arrow-right me-1"></i> Sair
          <% end %>
        </div>
      </aside>

      <!-- Main Content -->
      <main class="flex-grow-1 p-4 p-md-5 overflow-auto" style="background-color: var(--premium-background);">
        <div class="admin-container mx-auto" style="max-width: 1400px;">
          <%= yield %>
        </div>
      </main>
    </div>

    <style>
      .admin-sidebar {
        width: 280px;
        position: sticky;
        top: 0;
        height: 100vh;
        z-index: 100;
        transition: all 0.3s ease;
      }
      .admin-sidebar .nav-link {
        border-radius: 0.75rem;
        padding: 0.75rem 1rem;
        transition: all 0.2s;
      }
      .admin-sidebar .nav-link:hover:not(.active) {
        background-color: rgba(255, 255, 255, 0.1);
      }
      .admin-sidebar .nav-link.active {
        background: var(--primary-gradient);
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
      }
      .cursor-not-allowed {
        cursor: not-allowed;
      }
      @media (max-width: 768px) {
        .admin-sidebar {
          width: 80px;
        }
        .admin-sidebar span, .admin-sidebar .small {
          display: none;
        }
        .admin-sidebar .nav-link {
          text-align: center;
          padding: 0.75rem 0;
        }
        .admin-sidebar .bi {
          margin: 0 !important;
          font-size: 1.25rem;
        }
      }
    </style>
  </body>
</html>
