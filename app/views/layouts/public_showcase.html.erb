<!DOCTYPE html>
<html data-controller="theme">
  <head>
    <title><%= t("public_collections.layout.title", name: display_name(@user)) %> | Smart Collection</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= render "shared/javascript_i18n" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <link rel="icon" type="image/png" href="/logo/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/logo/favicon.svg" />
    <link rel="shortcut icon" href="/logo/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/logo/apple-touch-icon.png" />
    <link rel="manifest" href="/logo/site.webmanifest" />
    <script>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = savedTheme || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <style>
      :root {
        --public-primary: #4F46E5;
        --public-primary-dark: #4338CA;
        --public-bg: #F9FAFB;
        --public-surface: #FFFFFF;
        --public-text: #111827;
        --public-text-muted: #6B7280;
      }
      [data-theme="dark"] {
        --public-primary: #818cf8;
        --public-bg: #020617;
        --public-surface: #0f172a;
        --public-text: #f1f5f9;
        --public-text-muted: #94a3b8;
      }
      body {
        font-family: 'Outfit', 'Inter', sans-serif;
        background-color: var(--public-bg);
        color: var(--public-text);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      .navbar-glass {
        background: var(--glass-bg) !important;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--glass-border) !important;
      }
      .brand-text {
        font-weight: 800;
        letter-spacing: 0;
        font-size: 1.5rem;
      }
      .brand-icon {
        color: var(--public-primary);
        font-size: 1.75rem;
        transition: transform 0.3s ease;
      }
      .navbar-brand:hover .brand-icon {
        transform: rotate(15deg);
      }
      main {
        flex: 1;
      }
      .footer-glass {
        background: var(--public-surface);
        border-top: 1px solid var(--glass-border);
      }
    </style>
  </head>

  <body>
    <header class="navbar navbar-expand-lg sticky-top navbar-glass py-3">
      <div class="container-fluid app-container public-container">
        <%= link_to root_path, class: "navbar-brand d-flex align-items-center text-decoration-none" do %>
          <%= image_tag "/logo/logo.png", alt: "Smart Collection", height: 32, class: "me-2 theme-logo", data: { theme_target: "logo", dark_src: "/logo/logo-dark.png", light_src: "/logo/logo.png" } %>
          <span class="brand-text">Smart<span style="color: var(--public-primary);">Collection</span></span>
        <% end %>

        <button class="btn btn-link text-decoration-none p-2 rounded-circle theme-toggle-btn"
                data-action="click->theme#toggle"
                title="<%= t("public_collections.layout.toggle_theme") %>">
          <i class="bi bi-moon-stars-fill fs-5" data-theme-target="icon"></i>
        </button>
      </div>
    </header>

    <main>
      <%= yield %>
    </main>

    <%= turbo_frame_tag "modal", data: { controller: "modal-frame" } %>

    <footer class="py-5 footer-glass mt-5">
      <div class="container-fluid app-container public-container text-center">
        <div class="d-flex align-items-center justify-content-center mb-3">
          <%= image_tag "/logo/logo.png", alt: "Smart Collection", height: 28, class: "me-2 opacity-75 theme-logo", data: { theme_target: "logo", dark_src: "/logo/logo-dark.png", light_src: "/logo/logo.png" } %>
          <span class="brand-text fs-5">SmartCollection</span>
        </div>
        <p class="text-muted small mb-4" style="color: var(--public-text-muted) !important;"><%= t("public_collections.layout.footer_text") %></p>
        <div>
          <%= link_to t("public_collections.layout.create_collection"), new_user_registration_path, class: "btn text-white fw-medium rounded-pill px-5 py-2 hover-lift shadow-sm", style: "background-color: var(--public-primary);" %>
        </div>
      </div>
    </footer>
  </body>
</html>
