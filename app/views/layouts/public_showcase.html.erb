<!DOCTYPE html>
<html data-controller="theme">
  <head>
    <title><%= t("public_collections.layout.title", name: display_name(@user)) %> | Smart Collection</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= render "shared/javascript_i18n" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <link rel="icon" type="image/png" href="<%= versioned_public_path('/logo/favicon-96x96.png') %>" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="<%= versioned_public_path('/logo/favicon.svg') %>" />
    <link rel="shortcut icon" href="<%= versioned_public_path('/logo/favicon.ico') %>" />
    <link rel="apple-touch-icon" sizes="180x180" href="<%= versioned_public_path('/logo/apple-touch-icon.png') %>" />
    <link rel="manifest" href="<%= versioned_public_path('/logo/site.webmanifest') %>" />
    <script nonce="<%= content_security_policy_nonce %>">
      (function() {
        const savedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = savedTheme || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <style>
      :root {
        --public-primary: #2f6f68;
        --public-primary-dark: #214f4a;
        --public-bg: #f6f1e8;
        --public-surface: #fffdfa;
        --public-text: #1f2933;
        --public-text-muted: #68737d;
      }
      [data-theme="dark"] {
        --public-primary: #78a6a0;
        --public-bg: #111518;
        --public-surface: #15191c;
        --public-text: #f7f1e8;
        --public-text-muted: #b7aea3;
      }
      body {
        font-family: 'Outfit', 'Inter', sans-serif;
        background-color: var(--public-bg);
        color: var(--public-text);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      .navbar-glass {
        background: var(--public-surface) !important;
        border-bottom: 1px solid var(--border-color) !important;
      }
      .brand-text {
        font-weight: 800;
        letter-spacing: 0;
        font-size: 1.5rem;
      }
      .brand-icon {
        color: var(--public-primary);
        font-size: 1.75rem;
      }
      main {
        flex: 1;
      }
      .footer-glass {
        background: var(--public-surface);
        border-top: 1px solid var(--border-color);
      }
    </style>
  </head>

  <body>
    <header class="navbar navbar-expand-lg sticky-top navbar-glass py-3">
      <div class="container-fluid app-container public-container">
        <%= link_to root_path, class: "navbar-brand d-flex align-items-center text-decoration-none" do %>
          <%= image_tag versioned_public_path("/logo/logo.png"),
                        alt: "Smart Collection",
                        height: 32,
                        class: "me-2 theme-logo",
                        data: {
                          theme_target: "logo",
                          dark_src: versioned_public_path("/logo/logo-dark.png"),
                          light_src: versioned_public_path("/logo/logo.png")
                        } %>
          <span class="brand-text">Smart<span style="color: var(--public-primary);">Collection</span></span>
        <% end %>

        <button class="btn btn-link text-decoration-none p-2 rounded-circle theme-toggle-btn"
                data-action="click->theme#toggle"
                data-theme-target="button"
                title="<%= t("public_collections.layout.toggle_theme") %>"
                aria-label="<%= t("public_collections.layout.toggle_theme") %>"
                aria-pressed="false">
          <i class="bi bi-moon-stars-fill fs-5" data-theme-target="icon"></i>
        </button>
      </div>
    </header>

    <main>
      <%= yield %>
    </main>

    <%= turbo_frame_tag "modal", data: { controller: "modal-frame" } %>

    <footer class="py-5 footer-glass mt-5">
      <div class="container-fluid app-container public-container text-center">
        <div class="d-flex align-items-center justify-content-center mb-3">
          <%= image_tag versioned_public_path("/logo/logo.png"),
                        alt: "Smart Collection",
                        height: 28,
                        class: "me-2 opacity-75 theme-logo",
                        data: {
                          theme_target: "logo",
                          dark_src: versioned_public_path("/logo/logo-dark.png"),
                          light_src: versioned_public_path("/logo/logo.png")
                        } %>
          <span class="brand-text fs-5">SmartCollection</span>
        </div>
        <p class="text-muted small mb-4" style="color: var(--public-text-muted) !important;"><%= t("public_collections.layout.footer_text") %></p>
        <div>
          <%= link_to t("public_collections.layout.create_collection"), new_user_registration_path, class: "btn text-white fw-medium rounded-3 px-5 py-2 hover-lift shadow-sm", style: "background-color: var(--public-primary);" %>
        </div>
      </div>
    </footer>
  </body>
</html>
