<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">
      <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-4 p-md-5">
          <div class="mb-4">
            <span class="badge rounded-3 bg-primary-subtle text-primary mb-3">
              <%= t('initial_setup.badge') %>
            </span>
            <h1 class="fw-bold mb-2 fs-3"><%= t('initial_setup.title') %></h1>
            <p class="text-muted mb-0"><%= t('initial_setup.subtitle') %></p>
          </div>

          <%= form_with model: current_user, url: initial_setup_path, method: :patch do |f| %>
            <div class="vstack gap-3 mb-4">
              <div class="initial-setup-option">
                <div class="d-flex gap-3 align-items-start">
                  <%= f.check_box :sharing_enabled,
                                  class: "initial-setup-switch-input",
                                  role: "switch" %>
                  <%= f.label :sharing_enabled, class: "initial-setup-switch-label" do %>
                    <span class="initial-setup-switch" aria-hidden="true"></span>
                    <span class="min-w-0">
                      <span class="d-block fw-bold text-dark"><%= t('initial_setup.public_sharing.title') %></span>
                      <span class="d-block text-muted small mt-1">
                        <%= t('initial_setup.public_sharing.description') %>
                      </span>
                    </span>
                  <% end %>
                </div>
              </div>

              <div class="initial-setup-option">
                <div class="d-flex gap-3 align-items-start">
                  <%= f.check_box :ai_upscaling_enabled,
                                  disabled: !ImageUpscalerService.service_configured?,
                                  class: "initial-setup-switch-input",
                                  role: "switch" %>
                  <%= f.label :ai_upscaling_enabled, class: "initial-setup-switch-label" do %>
                    <span class="initial-setup-switch" aria-hidden="true"></span>
                    <span class="min-w-0">
                      <span class="d-block fw-bold text-dark"><%= t('initial_setup.ai_upscaling.title') %></span>
                      <span class="d-block text-muted small mt-1">
                        <%= ImageUpscalerService.service_configured? ? t('initial_setup.ai_upscaling.description') : t('initial_setup.ai_upscaling.unavailable') %>
                      </span>
                    </span>
                  <% end %>
                </div>
              </div>
            </div>

            <div class="d-flex justify-content-end">
              <%= f.submit t('initial_setup.actions.finish'),
                           class: "btn btn-premium rounded-3 px-4 fw-bold shadow-sm" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
