<% modal = local_assigns.fetch(:modal, false) %>

<div class="row <%= modal ? "g-4" : "g-5" %>">
  <div class="col-lg-7 mb-4 mb-lg-0">
    <div class="card car-detail-card border-0 shadow-sm rounded-4 overflow-hidden bg-white h-100">
      <% if car.photo? %>
        <div class="public-detail-photo p-4 d-flex align-items-center justify-content-center h-100 bg-light bg-opacity-50 position-relative" data-bs-toggle="modal" data-bs-target="#photoLightboxPublic">
          <%= image_tag car.photo.url, class: "img-fluid w-100 rounded-3 shadow-sm", alt: car.name.presence || t("cars.show.fallback_name") %>
          <div class="position-absolute bottom-0 end-0 m-4">
            <span class="badge bg-dark bg-opacity-75 rounded-pill px-3 py-2 text-white shadow-sm backdrop-blur">
              <i class="bi bi-zoom-in me-1"></i> <%= t("cars.show.view_full_photo") %>
            </span>
          </div>
        </div>
      <% else %>
        <div class="public-detail-empty-photo bg-light d-flex align-items-center justify-content-center text-muted h-100">
          <div class="text-center">
            <i class="bi bi-camera display-1 opacity-20 d-block mb-3"></i>
            <span class="fs-5 fw-medium text-muted opacity-75"><%= t("cars.show.no_photo") %></span>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card car-detail-card border-0 shadow-sm rounded-4 bg-white h-100">
      <div class="card-body p-4 p-xl-5 d-flex flex-column">
        <div class="mb-4">
          <h1 class="<%= modal ? "h2" : "display-5" %> fw-bold mb-3 text-dark"><%= car.name.presence || t("cars.show.fallback_name") %></h1>
          <div class="d-flex flex-wrap gap-2">
            <% if car.brand? %>
              <span class="badge rounded-pill px-3 py-2 fw-medium fs-6 public-brand-badge"><%= car.brand %></span>
            <% end %>
          </div>
        </div>

        <div class="public-detail-meta mb-4">
          <% if car.year? %>
            <div class="public-detail-meta-item">
              <span class="public-detail-meta-label"><%= t("activerecord.attributes.car.year") %></span>
              <strong class="public-detail-meta-value"><%= car.year %></strong>
            </div>
          <% end %>
          <% if car.size? %>
            <div class="public-detail-meta-item">
              <span class="public-detail-meta-label"><%= t("activerecord.attributes.car.size") %></span>
              <strong class="public-detail-meta-value text-uppercase"><%= car.size %></strong>
            </div>
          <% end %>
          <div class="public-detail-meta-item">
            <span class="public-detail-meta-label"><%= t("activerecord.attributes.car.color") %></span>
            <strong class="public-detail-meta-value d-flex align-items-center gap-2">
              <% if car.color? %>
                <span class="d-inline-block rounded-circle shadow-sm public-detail-color-dot" style="background-color:<%= Car::COLORS[car.color] || '#ccc' %>;"></span>
              <% end %>
              <%= car.color.presence || t("cars.show.fallback_name") %>
            </strong>
          </div>
        </div>

        <div class="mb-4 flex-grow-1">
          <div class="text-muted small mb-2 fw-medium text-uppercase"><%= t("activerecord.attributes.car.observations") %></div>
          <div class="text-dark bg-light bg-opacity-50 p-4 rounded-4 border border-light shadow-sm public-detail-notes">
            <%= simple_format(car.observations.presence || t("cars.show.fallback_name")) %>
          </div>
        </div>

        <div class="public-detail-footer mt-auto pt-4 border-top text-muted small">
          <div class="d-flex align-items-start gap-2">
            <i class="bi bi-info-circle opacity-50 mt-1"></i>
            <div>
              <span class="d-block"><%= t("cars.show.added_at", date: l(car.created_at.to_date, format: :long)) %></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<% if car.photo? %>
  <div class="modal fade" id="photoLightboxPublic" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
      <div class="modal-content bg-transparent border-0 shadow-none">
        <div class="modal-body p-0 text-center position-relative d-inline-block w-auto mx-auto">
          <%= image_tag car.photo.url,
                class: "rounded-4 shadow-lg d-block public-lightbox-image",
                alt: car.name.presence || t("cars.show.fallback_name") %>
          <button type="button"
                  class="btn btn-dark btn-sm rounded-circle shadow position-absolute public-lightbox-close"
                  data-bs-dismiss="modal"
                  aria-label="<%= t("actions.close") %>">
            <i class="bi bi-x-lg small"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
<% end %>
