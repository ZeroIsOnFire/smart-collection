<div class="hero-gradient-subtle"></div>

<div class="container py-5 position-relative" style="z-index: 1;">
  <div class="mb-4">
    <%= link_to public_share_path(@user.share_token, current_locale_param), class: "btn text-muted hover-lift d-inline-flex align-items-center gap-2 text-decoration-none border-0 bg-transparent px-0 fw-medium", data: { turbo_action: "advance" } do %>
      <i class="bi bi-arrow-left"></i> <%= t("public_collections.show.back_to_collection") %>
    <% end %>
  </div>

  <% cache ['public', @car, I18n.locale] do %>
    <%= render "public_collections/show_content", car: @car, user: @user %>
  <% end %>
</div>
