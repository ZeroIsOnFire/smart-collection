<div class="hero-gradient text-white pt-5 pb-5 mb-0">
  <div class="container-fluid app-container public-container py-4">
    <div class="row align-items-center position-relative" style="z-index: 2;">
      <div class="col-lg-8">
        <h1 class="display-3 fw-bold mb-3"><%= t("public_collections.index.title", name: display_name(@user)) %></h1>
        <p class="lead fs-4 opacity-75 mb-0 fw-light"><%= t("public_collections.index.subtitle") %></p>
        <% if @user.wishlist_sharing_enabled? && @user.wishlist_share_token.present? %>
          <div class="d-flex flex-column flex-sm-row align-items-start gap-2 mt-4">
            <%= link_to public_wishlist_url(@user.wishlist_share_token),
                        class: "btn btn-light rounded-3 px-4 d-inline-flex align-items-center gap-2" do %>
              <i class="bi bi-stars"></i>
              <%= t("public_collections.index.open_wishlist") %>
            <% end %>
            <%= render "shared/native_link_share_button",
                       title: t("public_collections.index.title", name: display_name(@user)),
                       text: t("public_collections.index.subtitle") %>
          </div>
        <% else %>
          <div class="mt-4">
            <%= render "shared/native_link_share_button",
                       title: t("public_collections.index.title", name: display_name(@user)),
                       text: t("public_collections.index.subtitle") %>
          </div>
        <% end %>
      </div>
      <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
        <div class="public-collection-stat d-inline-flex flex-column align-items-center rounded-3 p-3">
          <span class="public-collection-stat-number fs-2 fw-bold lh-1"><%= @total_count %></span>
          <span class="public-collection-stat-label small text-uppercase fw-semibold mt-1">
            <i class="bi bi-car-front-fill me-1"></i> <%= t("public_collections.index.cataloged_count") %>
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container-fluid app-container public-container mb-5">
  <% public_results_count = @cars.total_count %>
  <% search_query = params[:q].to_s.strip %>
  <% public_car_filters_active = params.values_at(:brand, :size, :year, :color).any?(&:present?) %>

  <div class="row mb-5 search-wrapper">
    <div class="col-12 col-lg-8 mx-auto">
      <%= form_with url: public_share_path(@user.share_token),
                    method: :get,
                    class: "position-relative",
                    data: {
                      controller: "search-form",
                      turbo_frame: "cars_grid"
                    } do |f| %>
        <div class="wishlist-search-controls public-collection-search-controls d-flex gap-2 align-items-stretch">
          <div class="input-group input-group-lg premium-search-container shadow-sm border border-light border-opacity-50 rounded-3 overflow-hidden bg-white flex-grow-1">
            <span class="input-group-text border-0 bg-transparent ps-4 pe-2">
              <i class="bi bi-search text-muted fs-5"></i>
            </span>
            <%= f.text_field :q,
                             value: params[:q],
                             placeholder: t("public_collections.index.search_placeholder", name: display_name(@user)),
                             class: "form-control border-0 py-4 fs-5 shadow-none bg-transparent fw-light",
                             autocomplete: "off",
                             data: {
                               search_form_target: "input",
                               action: "input->search-form#submit"
                             } %>

            <div class="search-status public-search-status d-none d-flex align-items-center me-2"
                 role="status"
                 aria-live="polite"
                 data-search-form-target="spinner">
              <div class="spinner-border spinner-border-sm text-primary" role="status">
                <span class="visually-hidden"><%= t("public_collections.index.searching") %></span>
              </div>
              <span class="search-status-label"><%= t("public_collections.index.searching") %></span>
            </div>

            <% if params[:q].present? || public_car_filters_active %>
              <%= link_to public_share_path(@user.share_token),
                          class: "btn border-0 bg-transparent text-muted px-4 d-flex align-items-center search-clear-button",
                          title: t("public_collections.index.clear_search"),
                          aria: { label: t("public_collections.index.clear_search") } do %>
                <i class="bi bi-x-circle"></i>
              <% end %>
            <% end %>

            <button type="submit" class="btn btn-premium px-4 rounded-3 m-1 d-none d-sm-block">
              <%= t('actions.search') %>
            </button>
            <button type="submit" class="btn btn-premium px-3 rounded-3 m-1 d-sm-none" aria-label="<%= t('actions.search') %>">
              <i class="bi bi-search"></i>
            </button>
          </div>

          <div class="dropdown">
            <button class="btn btn-soft-secondary wishlist-filter-button px-3 rounded-3 d-flex align-items-center gap-2 h-100"
                    type="button"
                    data-bs-toggle="dropdown"
                    data-bs-auto-close="outside"
                    aria-expanded="false"
                    aria-label="<%= t('public_collections.index.filter_menu') %>">
              <i class="bi bi-sliders"></i>
              <span class="d-none d-sm-inline"><%= t('public_collections.index.filter_menu') %></span>
            </button>
            <div class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-3 p-3 wishlist-filter-menu">
              <div class="small fw-bold text-muted text-uppercase mb-3">
                <%= t('public_collections.index.filter_menu') %>
              </div>

              <div class="mb-3">
                <%= f.label :size, t('activerecord.attributes.car.size'), class: "form-label small fw-semibold text-muted" %>
                <%= f.select :size,
                             options_for_select([[t('cars.index.filters.all_scales'), '']] + Car.scale_options, params[:size]),
                             {},
                             class: "form-select rounded-3" %>
              </div>

              <div class="mb-3">
                <%= f.label :brand, t('activerecord.attributes.car.brand'), class: "form-label small fw-semibold text-muted" %>
                <%= f.select :brand,
                             options_for_select([[t('cars.index.filters.all_brands'), '']] + @brands.map { |brand| [brand, brand] }, params[:brand]),
                             {},
                             class: "form-select rounded-3" %>
              </div>

              <div class="mb-3">
                <%= f.label :year, t('activerecord.attributes.car.year'), class: "form-label small fw-semibold text-muted" %>
                <%= f.select :year,
                             options_for_select([[t('cars.index.filters.all_years'), '']] + @years.map { |year| [year, year] }, params[:year]),
                             {},
                             class: "form-select rounded-3" %>
              </div>

              <div class="mb-3">
                <%= f.label :color, t('activerecord.attributes.car.color'), class: "form-label small fw-semibold text-muted" %>
                <%= f.select :color,
                             options_for_select([[t('cars.index.filters.all_colors'), '']] + Car.color_options, params[:color]),
                             {},
                             class: "form-select rounded-3" %>
              </div>

              <div class="d-grid gap-2">
                <button type="submit" class="btn btn-premium rounded-3">
                  <i class="bi bi-funnel me-1"></i>
                  <%= t('actions.filter') %>
                </button>
                <%= link_to public_share_path(@user.share_token),
                            class: "btn btn-soft-secondary rounded-3",
                            title: t("public_collections.index.clear_search"),
                            aria: { label: t("public_collections.index.clear_search") } do %>
                  <%= t('cars.index.clear_filters') %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <turbo-frame id="cars_grid">
  <div data-controller="view-toggle"
       data-view-toggle-storage-key-value="public_collection_view_preference">
    <div class="collection-view-controls d-flex justify-content-between align-items-center">
      <div class="collection-results-summary text-muted small" aria-live="polite">
        <% if search_query.present? %>
          <%= t("public_collections.index.results_count_filtered", count: public_results_count, query: search_query) %>
        <% else %>
          <%= t("public_collections.index.results_count", count: public_results_count) %>
        <% end %>
      </div>
      <div class="btn-group shadow-sm bg-white rounded-3 p-1 border public-view-toggle">
        <button type="button" class="btn btn-sm text-primary active rounded-3 px-3 fw-medium d-flex align-items-center gap-2" data-view-toggle-target="gridButton" data-action="click->view-toggle#setGrid">
          <i class="bi bi-grid-fill"></i> <%= t("public_collections.index.grid_view") %>
        </button>
        <button type="button" class="btn btn-sm text-muted rounded-3 px-3 fw-medium d-flex align-items-center gap-2" data-view-toggle-target="listButton" data-action="click->view-toggle#setList">
          <i class="bi bi-list-ul"></i> <%= t("public_collections.index.list_view") %>
        </button>
        <button type="button" class="btn btn-sm text-muted rounded-3 px-3 fw-medium d-flex align-items-center gap-2" data-view-toggle-target="galleryButton" data-action="click->view-toggle#setGallery">
          <i class="bi bi-images"></i> <%= t("public_collections.index.gallery_view") %>
        </button>
      </div>
    </div>

      <div id="cars_list_container" class="position-relative mt-2">
        <% if @cars.any? %>
          <%= render "public_collections/gallery", cars: @cars, user: @user %>

          <div id="cars_grid_inner" class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4 pt-2 grid-view is-public">
            <%= render partial: "cars/car", collection: @cars, locals: { public: true, user: @user } %>
          </div>

          <% if @has_more %>
            <%= render partial: "cars/sentinel",
                       locals: { next_page: @cars.next_page,
                                 url: public_share_path(@user.share_token, @filter_params.merge(page: @cars.next_page, format: :turbo_stream)) } %>
          <% end %>
        <% else %>
          <div class="text-center py-5 mt-4 public-empty-state">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white shadow-sm mb-4 public-empty-icon">
              <i class="bi bi-search display-4 text-muted opacity-25"></i>
            </div>
            <h3 class="fw-bold mb-2"><%= t("public_collections.index.empty_title") %></h3>
            <p class="text-muted mb-0 fs-5"><%= t("public_collections.index.empty_text") %></p>
          </div>
        <% end %>
      </div>
  </div>
  </turbo-frame>
</div>
