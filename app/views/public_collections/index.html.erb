<style>
  .hero-gradient {
    background: linear-gradient(135deg, var(--public-primary-dark) 0%, var(--public-primary) 100%);
    position: relative;
    overflow: hidden;
  }
  .hero-gradient::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%23ffffff' fill-opacity='0.05' fill-rule='evenodd'/%3E%3C/svg%3E");
    pointer-events: none;
  }
  .search-wrapper {
    transform: translateY(-50%);
    z-index: 10;
    position: relative;
  }
  .premium-search-container {
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
    transition: all 0.3s ease;
  }
  .premium-search-container:focus-within {
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
    transform: translateY(-2px);
  }
</style>

<div class="hero-gradient text-white pt-5 pb-5 mb-0">
  <div class="container-fluid app-container public-container py-4">
    <div class="row align-items-center position-relative" style="z-index: 2;">
      <div class="col-lg-8">
        <h1 class="display-3 fw-bold tracking-tight mb-3" style="letter-spacing: -0.02em;">Coleção de <%= display_name(@user) %></h1>
        <p class="lead fs-4 opacity-75 mb-0 fw-light">Explore uma cuidadosa curadoria de veículos exclusivos.</p>
      </div>
      <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
        <div class="d-inline-flex flex-column align-items-center bg-white bg-opacity-10 rounded-4 p-3 backdrop-blur">
          <span class="fs-2 fw-bold text-white lh-1"><%= @total_count %></span>
          <span class="text-white-50 small text-uppercase tracking-wider fw-semibold mt-1">
            <i class="bi bi-car-front-fill me-1"></i> Veículos catalogados
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container-fluid app-container public-container mb-5">
  <!-- Campo de Busca embutido para visitantes -->
  <div class="row mb-5 search-wrapper">
    <div class="col-12 col-lg-8 mx-auto">
      <%= form_with url: public_share_path(@user.share_token),
                    method: :get,
                    class: "position-relative",
                    data: {
                      controller: "search-form",
                      turbo_frame: "cars_grid"
                    } do |f| %>
        <div class="input-group input-group-lg premium-search-container shadow-sm border border-light border-opacity-50 rounded-pill overflow-hidden bg-white">
          <span class="input-group-text border-0 bg-transparent ps-4 pe-2">
            <i class="bi bi-search text-muted fs-5"></i>
          </span>
          <%= f.text_field :q,
                           value: params[:q],
                           placeholder: "Buscar na coleção de #{display_name(@user)}...",
                           class: "form-control border-0 py-4 fs-5 shadow-none bg-transparent fw-light",
                           autocomplete: "off",
                           data: {
                             search_form_target: "input",
                             action: "input->search-form#submit"
                           } %>

          <div class="spinner-border spinner-border-sm text-primary position-absolute end-0 top-50 translate-middle-y me-4 d-none"
               role="status"
               data-search-form_target="spinner">
            <span class="visually-hidden">Carregando...</span>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Grade listagem & Toggles - Wrapped for Stimulus -->
  <div data-controller="view-toggle">
    <div class="d-flex justify-content-between align-items-center mb-5">
      <div class="text-muted small"></div>
      <div class="btn-group shadow-sm bg-white rounded-pill p-1 border">
        <button type="button" class="btn btn-sm text-primary active rounded-pill px-3 fw-medium d-flex align-items-center gap-2" data-view-toggle-target="gridButton" data-action="click->view-toggle#setGrid">
          <i class="bi bi-grid-fill"></i> Grade
        </button>
        <button type="button" class="btn btn-sm text-muted rounded-pill px-3 fw-medium d-flex align-items-center gap-2" data-view-toggle-target="listButton" data-action="click->view-toggle#setList">
          <i class="bi bi-list-ul"></i> Lista
        </button>
      </div>
    </div>

    <!-- Grid de carros -->
    <turbo-frame id="cars_grid">
      <div id="cars_list_container" class="position-relative mt-2">
        <% if @cars.any? %>
          <div id="cars_grid_inner" class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4 pt-2 grid-view is-public">
            <%= render partial: "cars/car", collection: @cars, locals: { public: true, user: @user } %>
          </div>

          <!-- Sentinela de infinite scroll para o share -->
          <% if @has_more %>
            <%= render partial: "cars/sentinel", locals: { next_page: @cars.next_page, url: public_share_path(@user.share_token, page: @cars.next_page, q: params[:q], format: :turbo_stream) } %>
          <% end %>
        <% else %>
          <div class="text-center py-5 mt-4">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white shadow-sm mb-4" style="width: 100px; height: 100px;">
              <i class="bi bi-search display-4 text-muted opacity-25"></i>
            </div>
            <h3 class="fw-bold mb-2">Nenhum veículo encontrado</h3>
            <p class="text-muted mb-0 fs-5">Tente buscar por outro termo ou limpe a pesquisa.</p>
          </div>
        <% end %>
      </div>
    </turbo-frame>
  </div>
</div>
