<% if @page > 1 %>
  <%# Se for paginação (infinite scroll), apenas anexamos os novos carros %>
  <%= turbo_stream.append "cars_grid_inner" do %>
    <%= render partial: "cars/car", collection: @cars, locals: { public: true, user: @user } %>
  <% end %>

  <%= turbo_stream.append "public_gallery_slides" do %>
    <%= render partial: "public_collections/gallery_slide",
               collection: @cars,
               as: :car,
               locals: { user: @user, gallery_id: "publicCollectionCarousel", active: false } %>
  <% end %>

  <%= turbo_stream.append "public_gallery_thumbnails" do %>
    <% offset = ((@page - 1) * @cars.limit_value).to_i %>
    <% @cars.each_with_index do |car, index| %>
      <%= render "public_collections/gallery_thumbnail",
                 car: car,
                 user: @user,
                 gallery_id: "publicCollectionCarousel",
                 gallery_thumbnail_counter: offset + index,
                 active: false %>
    <% end %>
  <% end %>

  <% if @has_more %>
    <%= turbo_stream.replace "cars_sentinel" do %>
      <%= render partial: "cars/sentinel",
                 locals: { next_page: @cars.next_page,
                           url: public_share_path(@user.share_token, @filter_params.merge(page: @cars.next_page, format: :turbo_stream)) } %>
    <% end %>
  <% else %>
    <%= turbo_stream.remove "cars_sentinel" %>
  <% end %>

<% else %>
  <%# Se for uma busca (primeira página) ou limpar busca, substituímos toda a grade %>
  <%= turbo_stream.update "cars_list_container" do %>
    <% if @cars.any? %>
      <%= render "public_collections/gallery", cars: @cars, user: @user %>

      <div id="cars_grid_inner" class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4 mt-2 grid-view is-public">
        <%= render partial: "cars/car", collection: @cars, locals: { public: true, user: @user } %>
      </div>
      <% if @has_more %>
        <div id="cars_sentinel" class="row mt-4">
          <%= render partial: "cars/sentinel",
                     locals: { next_page: @cars.next_page,
                               url: public_share_path(@user.share_token, @filter_params.merge(page: @cars.next_page, format: :turbo_stream)) } %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-5 public-empty-state">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white shadow-sm mb-4 public-empty-icon">
          <i class="bi bi-search fs-2 text-muted opacity-50"></i>
        </div>
        <h4 class="fw-bold mb-2"><%= t("public_collections.index.empty_title") %></h4>
      </div>
    <% end %>
  <% end %>
<% end %>
