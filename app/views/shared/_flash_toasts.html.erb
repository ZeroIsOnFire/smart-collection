<div aria-live="polite" aria-atomic="true" class="position-relative">
  <div id="flash_toasts" class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
    <% flash.each do |type, message| %>
      <% 
        bg_class = case type.to_s
                   when 'notice', 'success' then 'bg-success'
                   when 'alert', 'error' then 'bg-danger'
                   else 'bg-primary'
                   end
      %>
      <div class="toast align-items-center text-white <%= bg_class %> border-0 mb-2 shadow-lg" 
           role="alert" aria-live="assertive" aria-atomic="true"
           data-controller="toast">
        <div class="d-flex">
          <div class="toast-body">
            <i class="bi <%= type.to_s == 'alert' || type.to_s == 'error' ? 'bi-exclamation-triangle' : 'bi-check-circle' %> me-2"></i>
            <%= message %>
          </div>
          <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
      </div>
    <% end %>
  </div>
</div>
