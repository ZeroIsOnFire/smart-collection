<% unless cookies[ApplicationController::COOKIE_CONSENT_KEY] == 'accepted' %>
  <section class="cookie-consent-banner shadow-lg" aria-label="<%= t('cookie_consent.title') %>">
    <div class="cookie-consent-content">
      <div>
        <h2><%= t('cookie_consent.title') %></h2>
        <p><%= t('cookie_consent.message') %></p>
      </div>
      <%= button_to t('cookie_consent.accept'),
                    cookie_consent_path,
                    method: :post,
                    params: { return_to: request.fullpath, locale: I18n.locale.to_s },
                    class: "btn btn-primary fw-semibold rounded-3 px-4" %>
    </div>
  </section>

  <style>
    .cookie-consent-banner {
      background-color: var(--card-bg, var(--public-surface, #fff));
      border: 1px solid var(--border-color, rgba(0, 0, 0, 0.12));
      border-radius: 8px;
      bottom: 1rem;
      color: var(--text-main, var(--public-text, #1f2933));
      left: 1rem;
      max-width: min(42rem, calc(100vw - 2rem));
      padding: 1rem;
      position: fixed;
      z-index: 1080;
    }

    [data-theme="dark"] .cookie-consent-banner {
      box-shadow: 0 18px 42px rgba(0, 0, 0, 0.55) !important;
    }

    .cookie-consent-content {
      align-items: center;
      display: flex;
      gap: 1rem;
      justify-content: space-between;
    }

    .cookie-consent-banner h2 {
      font-size: 1rem;
      font-weight: 800;
      letter-spacing: 0;
      margin: 0 0 0.25rem;
    }

    .cookie-consent-banner p {
      color: var(--text-muted, var(--public-text-muted, #68737d));
      font-size: 0.9rem;
      margin: 0;
    }

    @media (max-width: 575.98px) {
      .cookie-consent-banner {
        bottom: 0.75rem;
        left: 0.75rem;
        right: 0.75rem;
        max-width: none;
      }

      .cookie-consent-content {
        align-items: stretch;
        flex-direction: column;
      }
    }
  </style>
<% end %>
