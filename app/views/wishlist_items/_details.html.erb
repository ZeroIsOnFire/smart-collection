<div class="wishlist-details">
  <div class="card premium-card shadow-sm rounded-3 overflow-hidden mb-3">
    <% if wishlist_item.photo? %>
      <div class="bg-light d-flex align-items-center justify-content-center">
        <%= image_tag wishlist_item.photo.url,
                      alt: wishlist_item.name,
                      class: "img-fluid w-100",
                      style: "max-height: 420px; object-fit: contain;" %>
      </div>
    <% else %>
      <div class="bg-light d-flex align-items-center justify-content-center text-muted" style="height: 220px;">
        <div class="text-center">
          <i class="bi bi-camera fs-2 opacity-50 d-block mb-2"></i>
          <span class="small"><%= t('wishlist_items.card.no_photo') %></span>
        </div>
      </div>
    <% end %>

    <div class="card-body p-3 p-md-4">
      <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <div class="min-w-0">
          <h1 class="h4 fw-bold mb-1"><%= wishlist_item.name %></h1>
          <div class="d-flex flex-wrap gap-1">
            <% if wishlist_item.brand? %>
              <span class="collection-brand-badge"><%= wishlist_item.brand %></span>
            <% end %>
            <% if wishlist_item.scale? %>
              <span class="metadata-chip"><i class="bi bi-rulers"></i><%= wishlist_item.scale %></span>
            <% end %>
          </div>
        </div>
        <span class="badge rounded-pill text-bg-light border"><%= wishlist_item.priority_label %></span>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-sm-6">
          <div class="bg-light rounded-3 p-3 h-100">
            <div class="small text-muted mb-1"><%= t('mongoid.attributes.wishlist_item.status') %></div>
            <div class="fw-semibold"><%= wishlist_item.status_label %></div>
          </div>
        </div>
        <div class="col-sm-6">
          <div class="bg-light rounded-3 p-3 h-100">
            <div class="small text-muted mb-1"><%= t('mongoid.attributes.wishlist_item.priority') %></div>
            <div class="fw-semibold"><%= wishlist_item.priority_label %></div>
          </div>
        </div>
      </div>

      <% if wishlist_item.reference_url.present? %>
        <%= link_to wishlist_item.reference_url,
                    class: "btn btn-soft-secondary rounded-3 d-inline-flex align-items-center gap-2 mb-3",
                    target: "_blank",
                    rel: "noopener noreferrer" do %>
          <i class="bi bi-box-arrow-up-right"></i>
          <%= t('wishlist_items.actions.open_reference') %>
        <% end %>
      <% end %>

      <% if wishlist_item.observations.present? %>
        <div class="text-muted mb-0"><%= simple_format(wishlist_item.observations) %></div>
      <% end %>
    </div>
  </div>

  <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
    <%= button_to add_to_collection_wishlist_item_path(wishlist_item),
                  method: :post,
                  class: "btn btn-premium rounded-3 px-4" do %>
      <i class="bi bi-plus-circle me-1"></i>
      <%= t('wishlist_items.actions.add_to_collection') %>
    <% end %>
    <%= link_to edit_wishlist_item_path(wishlist_item),
                class: "btn btn-soft-secondary rounded-3 px-4",
                data: { turbo_frame: "modal" } do %>
      <i class="bi bi-pencil me-1"></i>
      <%= t('actions.edit') %>
    <% end %>
  </div>
</div>
