<div class="col animate-fade-in car-card-wrapper wishlist-card-wrapper" id="<%= dom_id(wishlist_item) %>">
  <div class="card premium-card wishlist-card h-100 shadow-sm border-0 position-relative rounded-3 overflow-hidden">
    <div class="position-absolute top-0 end-0 p-2 z-3 car-action-dropdown">
      <div class="dropdown">
        <button class="btn btn-sm bg-white bg-opacity-90 rounded-circle shadow-sm border-0"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                aria-label="<%= t('wishlist_items.card.actions_menu') %>"
                style="width: 32px; height: 32px; padding: 0;">
          <i class="bi bi-three-dots-vertical small"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
          <li>
            <%= link_to wishlist_item_path(wishlist_item),
                        class: 'dropdown-item d-flex align-items-center gap-2 py-2',
                        data: { turbo_frame: "modal" } do %>
              <i class="bi bi-eye text-muted"></i>
              <%= t('wishlist_items.card.view_details') %>
            <% end %>
          </li>
          <li>
            <%= link_to edit_wishlist_item_path(wishlist_item),
                        class: 'dropdown-item d-flex align-items-center gap-2 py-2',
                        data: { turbo_frame: "modal" } do %>
              <i class="bi bi-pencil text-muted"></i>
              <%= t('actions.edit') %>
            <% end %>
          </li>
          <li>
            <%= link_to wishlist_item_share_image_path(wishlist_item),
                        class: 'dropdown-item d-flex align-items-center gap-2 py-2',
                        data: { turbo_frame: "modal" } do %>
              <i class="bi bi-image text-muted"></i>
              <%= t('wishlist_items.actions.share_item_image') %>
            <% end %>
          </li>
          <li>
            <%= link_to new_car_from_wishlist_item_path(wishlist_item),
                        class: 'dropdown-item d-flex align-items-center gap-2 py-2',
                        data: { turbo_frame: "modal" } do %>
              <i class="bi bi-plus-circle text-muted"></i>
              <%= t('wishlist_items.actions.add_to_collection') %>
            <% end %>
          </li>
          <li><hr class="dropdown-divider"></li>
          <li>
            <%= button_to wishlist_item_path(wishlist_item),
                          method: :delete,
                          class: 'dropdown-item text-danger d-flex align-items-center gap-2 py-2',
                          form: { data: { turbo_confirm: t('wishlist_items.actions.delete_confirm') } } do %>
              <i class="bi bi-trash3"></i>
              <%= t('actions.delete') %>
            <% end %>
          </li>
        </ul>
      </div>
    </div>

    <%= link_to wishlist_item_path(wishlist_item),
                class: "text-decoration-none",
                data: { turbo_frame: "modal" } do %>
      <div class="car-photo-container wishlist-card-photo bg-light d-flex align-items-center justify-content-center text-muted" style="height: 180px; overflow: hidden;">
        <% if wishlist_item.photo? %>
          <%= image_tag wishlist_item.photo.url,
                        alt: wishlist_item.name,
                        loading: "lazy",
                        style: "width: 100%; height: 100%; object-fit: cover;" %>
        <% else %>
          <div class="text-center">
            <i class="bi bi-camera fs-3 opacity-30 d-block mb-1"></i>
            <small class="opacity-50"><%= t('wishlist_items.card.no_photo') %></small>
          </div>
        <% end %>
      </div>

      <div class="card-body wishlist-card-body px-3 pb-3 pt-2">
        <h2 class="card-title mb-0 fw-bold text-dark text-truncate fs-6"><%= wishlist_item.name %></h2>
        <div class="d-flex flex-wrap gap-1 mt-1 mb-2">
          <% if wishlist_item.brand? %>
            <span class="collection-brand-badge"><%= wishlist_item.brand %></span>
          <% end %>
          <% if wishlist_item.scale? %>
            <span class="metadata-chip metadata-chip-scale"><i class="bi bi-arrows-fullscreen"></i><%= wishlist_item.scale %></span>
          <% end %>
          <span class="metadata-chip"><i class="bi bi-flag"></i><%= wishlist_item.status_label %></span>
        </div>
      </div>
    <% end %>
  </div>
</div>
