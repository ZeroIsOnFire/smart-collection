<div class="row justify-content-center">
  <div class="col-12 col-xl-9">
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
      <div>
        <%= link_to wishlist_items_path, class: "btn text-muted hover-lift d-inline-flex align-items-center gap-2 text-decoration-none border-0 bg-transparent px-0 fw-medium mb-2" do %>
          <i class="bi bi-arrow-left"></i>
          <%= t('wishlist_items.actions.back_to_wishlist') %>
        <% end %>
        <h1 class="fw-bold mb-1 fs-3"><%= title %></h1>
        <p class="text-muted small mb-0"><%= subtitle %></p>
      </div>
    </div>

    <%= form_with model: wishlist_item, class: "card border-0 shadow-sm rounded-3" do |f| %>
      <div class="card-body p-4">
        <% if wishlist_item.errors.any? %>
          <div class="alert alert-danger rounded-3">
            <div class="fw-bold mb-1"><%= t('wishlist_items.form.validation_error_title') %></div>
            <ul class="mb-0">
              <% wishlist_item.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="row g-4">
          <div class="col-12 col-lg-5">
            <%= f.label :photo, t('mongoid.attributes.wishlist_item.photo'), class: "form-label fw-semibold" %>
            <div class="border rounded-3 bg-light p-3">
              <% if wishlist_item.photo? %>
                <%= image_tag wishlist_item.photo.url, alt: wishlist_item.name, class: "img-fluid rounded-3 mb-3" %>
              <% else %>
                <div class="ratio ratio-16x9 rounded-3 bg-white border d-flex align-items-center justify-content-center mb-3">
                  <div class="text-muted text-center">
                    <i class="bi bi-image fs-1 opacity-50"></i>
                    <div class="small"><%= t('wishlist_items.card.no_photo') %></div>
                  </div>
                </div>
              <% end %>
              <%= f.file_field :photo, class: "form-control rounded-3", accept: "image/*" %>
              <%= f.hidden_field :photo_cache %>
              <% if wishlist_item.photo? %>
                <div class="form-check mt-3">
                  <%= f.check_box :remove_photo, class: "form-check-input" %>
                  <%= f.label :remove_photo, t('wishlist_items.form.remove_photo'), class: "form-check-label" %>
                </div>
              <% end %>
              <div class="form-text"><%= t('wishlist_items.form.upload_limits') %></div>
            </div>
          </div>

          <div class="col-12 col-lg-7">
            <div class="row g-3">
              <div class="col-12">
                <%= f.label :name, class: "form-label fw-semibold" %>
                <%= f.text_field :name,
                                 class: "form-control rounded-3 #{'is-invalid' if field_error_message(wishlist_item, :name)}",
                                 placeholder: t('wishlist_items.form.name_placeholder'),
                                 autofocus: true %>
                <% if field_error_message(wishlist_item, :name) %>
                  <div class="invalid-feedback"><%= field_error_message(wishlist_item, :name) %></div>
                <% end %>
              </div>

              <div class="col-12 col-md-6">
                <%= f.label :brand, class: "form-label fw-semibold" %>
                <%= f.text_field :brand,
                                 class: "form-control rounded-3",
                                 placeholder: t('wishlist_items.form.brand_placeholder') %>
              </div>

              <div class="col-12 col-md-6">
                <%= f.label :scale, class: "form-label fw-semibold" %>
                <%= f.select :scale,
                             options_for_select([[t('wishlist_items.form.select_scale'), '']] + Car.scale_options, wishlist_item.scale),
                             {},
                             class: "form-select rounded-3" %>
              </div>

              <div class="col-12 col-md-6">
                <%= f.label :status, class: "form-label fw-semibold" %>
                <%= f.select :status, WishlistItem.status_options, {}, class: "form-select rounded-3" %>
              </div>

              <div class="col-12 col-md-6">
                <%= f.label :priority, class: "form-label fw-semibold" %>
                <%= f.select :priority, WishlistItem.priority_options, {}, class: "form-select rounded-3" %>
              </div>

              <div class="col-12 col-md-6">
                <%= f.label :target_price_cents, class: "form-label fw-semibold" %>
                <div class="input-group">
                  <span class="input-group-text rounded-start-3"><%= t('wishlist_items.form.price_prefix') %></span>
                  <%= f.number_field :target_price_cents,
                                     min: 0,
                                     step: 1,
                                     class: "form-control rounded-end-3",
                                     placeholder: t('wishlist_items.form.target_price_placeholder') %>
                </div>
                <div class="form-text"><%= t('wishlist_items.form.target_price_help') %></div>
              </div>

              <div class="col-12 col-md-6">
                <%= f.label :reference_url, class: "form-label fw-semibold" %>
                <%= f.url_field :reference_url,
                                class: "form-control rounded-3 #{'is-invalid' if field_error_message(wishlist_item, :reference_url)}",
                                placeholder: t('wishlist_items.form.reference_url_placeholder') %>
                <% if field_error_message(wishlist_item, :reference_url) %>
                  <div class="invalid-feedback"><%= field_error_message(wishlist_item, :reference_url) %></div>
                <% end %>
              </div>

              <div class="col-12">
                <%= f.label :observations, class: "form-label fw-semibold" %>
                <%= f.text_area :observations,
                                rows: 4,
                                class: "form-control rounded-3",
                                placeholder: t('wishlist_items.form.observations_placeholder') %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="card-footer bg-transparent border-0 d-flex justify-content-end gap-2 p-4 pt-0">
        <%= link_to t('actions.cancel'), wishlist_items_path, class: "btn btn-soft-secondary rounded-3 px-4" %>
        <%= f.submit t('actions.save'), class: "btn btn-premium rounded-3 px-4" %>
      </div>
    <% end %>
  </div>
</div>
