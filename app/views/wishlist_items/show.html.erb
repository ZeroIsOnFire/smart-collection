<div class="container-fluid py-4 app-container">
  <div class="row justify-content-center">
    <div class="col-12 col-xl-8">
      <%= link_to wishlist_items_path, class: "btn text-muted hover-lift d-inline-flex align-items-center gap-2 text-decoration-none border-0 bg-transparent px-0 fw-medium mb-3" do %>
        <i class="bi bi-arrow-left"></i>
        <%= t('wishlist_items.actions.back_to_wishlist') %>
      <% end %>

      <%= render "details", wishlist_item: @wishlist_item %>
    </div>
  </div>
</div>
