<div class="mb-5 d-flex align-items-center gap-3">
  <%= link_to admin_users_path, class: "btn btn-soft-secondary rounded-circle p-2 d-flex align-items-center justify-content-center", style: "width: 40px; height: 40px;" do %>
    <i class="bi bi-arrow-left fs-5"></i>
  <% end %>
  <div>
    <h2 class="fw-bold mb-1 text-dark">Detalhes do Usuário</h2>
    <p class="text-muted mb-0">Informações detalhadas e estatísticas de uso.</p>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="card premium-card border-0 rounded-4 p-4 text-center">
      <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm mx-auto mb-4" 
           style="width: 100px; height: 100px; font-size: 2.5rem; background-color: <%= user_avatar_color(@user) %>">
        <%= user_initials(@user) %>
      </div>
      <h4 class="fw-bold mb-1"><%= display_name(@user) %></h4>
      <p class="text-muted mb-3"><%= @user.email %></p>
      
      <div class="d-flex justify-content-center gap-2 mb-4">
        <% if @user.admin? %>
          <span class="badge bg-primary rounded-pill px-3 py-2">Administrador</span>
        <% end %>
        <span class="badge bg-light text-secondary border rounded-pill px-3 py-2">Membro desde <%= @user.created_at.strftime("%b %Y") %></span>
      </div>

      <div class="d-grid gap-2">
        <%= link_to edit_admin_user_path(@user), class: "btn btn-soft-secondary rounded-pill" do %>
          <i class="bi bi-pencil me-1"></i> Editar Usuário
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="row g-4 mb-4">
      <div class="col-md-6">
        <div class="card premium-card border-0 rounded-4 p-4">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-box bg-purple-light mb-0 rounded-3" style="width: 54px; height: 54px;">
              <i class="bi bi-car-front fs-3"></i>
            </div>
            <div>
              <div class="text-secondary small fw-bold text-uppercase tracking-wider">Itens no Catálogo</div>
              <div class="fs-2 fw-bold"><%= @stats[:cars_count] %></div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card premium-card border-0 rounded-4 p-4">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-box bg-emerald-light mb-0 rounded-3" style="width: 54px; height: 54px;">
              <i class="bi bi-robot fs-3"></i>
            </div>
            <div>
              <div class="text-secondary small fw-bold text-uppercase tracking-wider">Autodetecções</div>
              <div class="fs-2 fw-bold"><%= @stats[:autodetections_count] %></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card premium-card border-0 rounded-4 overflow-hidden">
      <div class="card-header bg-white border-bottom p-4">
        <h5 class="mb-0 fw-bold">Atividade Recente</h5>
      </div>
      <div class="card-body p-0">
        <div class="list-group list-group-flush">
          <% if @user.cars.any? %>
            <% @user.cars.desc(:created_at).limit(5).each do |car| %>
              <div class="list-group-item p-4 border-0 border-bottom">
                <div class="d-flex justify-content-between align-items-center">
                  <div class="d-flex align-items-center gap-3">
                    <% if car.photo? %>
                      <%= image_tag car.photo.url, class: "rounded", style: "width: 50px; height: 35px; object-fit: cover;" %>
                    <% else %>
                      <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted" style="width: 50px; height: 35px;">
                        <i class="bi bi-image" style="font-size: 0.7rem;"></i>
                      </div>
                    <% end %>
                    <div>
                      <div class="fw-bold small"><%= car.name %></div>
                      <div class="text-muted extra-small"><%= car.brand %> • Adicionado em <%= car.created_at.strftime("%d/%m/%Y") %></div>
                    </div>
                  </div>
                  <i class="bi bi-chevron-right text-muted"></i>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="p-5 text-center text-muted">
              <i class="bi bi-box-seam display-4 mb-3 d-block opacity-25"></i>
              Nenhum item cadastrado ainda.
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
