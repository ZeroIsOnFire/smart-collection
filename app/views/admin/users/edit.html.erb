<div class="mb-5 d-flex align-items-center gap-3">
  <%= link_to admin_user_path(@user), class: "btn btn-soft-secondary rounded-circle p-2 d-flex align-items-center justify-content-center", style: "width: 40px; height: 40px;" do %>
    <i class="bi bi-arrow-left fs-5"></i>
  <% end %>
  <div>
    <h2 class="fw-bold mb-1 text-dark">Editar Usuário</h2>
    <p class="text-muted mb-0">Altere informações básicas e privilégios de acesso.</p>
  </div>
</div>

<div class="row">
  <div class="col-lg-6">
    <div class="card premium-card border-0 rounded-4 p-5">
      <%= simple_form_for([:admin, @user]) do |f| %>
        <div class="mb-4">
          <%= f.input :name, 
                label: "Nome Completo", 
                input_html: { class: "form-control-lg rounded-3" },
                placeholder: "Ex: João Silva" %>
        </div>

        <div class="mb-4">
          <%= f.input :email, 
                label: "E-mail", 
                input_html: { class: "form-control-lg rounded-3" },
                placeholder: "email@exemplo.com" %>
        </div>

        <div class="mb-5 p-4 bg-light rounded-4 border">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <div class="fw-bold text-dark">Privilégios Administrativos</div>
              <div class="small text-muted">Permite acesso ao painel de controle global.</div>
            </div>
            <div class="form-check form-switch fs-4">
              <%= f.check_box :admin, class: "form-check-input", role: "switch", disabled: (@user == current_user) %>
            </div>
          </div>
          <% if @user == current_user %>
            <div class="mt-2 extra-small text-warning">
              <i class="bi bi-exclamation-triangle me-1"></i> Você não pode remover seus próprios privilégios.
            </div>
          <% end %>
        </div>

        <div class="d-flex gap-2 pt-3">
          <%= f.button :submit, "Salvar Alterações", class: "btn btn-primary rounded-pill px-5 py-3 fw-bold flex-grow-1" %>
          <%= link_to "Cancelar", admin_user_path(@user), class: "btn btn-soft-secondary rounded-pill px-4 d-flex align-items-center" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="alert alert-info border-0 rounded-4 p-4 shadow-sm">
      <h5 class="fw-bold"><i class="bi bi-info-circle me-2"></i> Boas Práticas</h5>
      <ul class="mb-0 mt-2 small">
        <li>Alterar o e-mail do usuário pode afetar o login dele.</li>
        <li>Promover um usuário a admin dá acesso total a todos os dados do sistema.</li>
        <li>Para trocar a senha de um usuário, oriente-o a usar a função "Esqueci minha senha" na tela de login.</li>
      </ul>
    </div>
  </div>
</div>
