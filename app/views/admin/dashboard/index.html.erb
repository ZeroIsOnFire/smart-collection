<div class="mb-5">
  <h2 class="fw-bold mb-1 text-dark">Dashboard Administrativo</h2>
  <p class="text-muted mb-0">Visão geral do sistema e métricas de uso.</p>
</div>

<div class="row g-4 mb-5">
  <!-- Usuários -->
  <div class="col-md-6 col-xl-3">
    <div class="card premium-card border-0 rounded-4 p-3 h-100">
      <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-3">
          <div class="icon-box bg-indigo-light mb-0 rounded-3" style="width: 48px; height: 48px;">
            <i class="bi bi-people fs-4"></i>
          </div>
          <div>
            <div class="text-secondary small fw-bold text-uppercase tracking-wider" style="font-size: 0.7rem;">Total de Usuários</div>
            <div class="fs-3 fw-bold"><%= @stats[:users_count] %></div>
          </div>
        </div>
        <div class="progress" style="height: 4px;">
          <div class="progress-bar bg-primary" role="progressbar" style="width: 100%"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Carros -->
  <div class="col-md-6 col-xl-3">
    <div class="card premium-card border-0 rounded-4 p-3 h-100">
      <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-3">
          <div class="icon-box bg-purple-light mb-0 rounded-3" style="width: 48px; height: 48px;">
            <i class="bi bi-car-front fs-4"></i>
          </div>
          <div>
            <div class="text-secondary small fw-bold text-uppercase tracking-wider" style="font-size: 0.7rem;">Carros no Acervo</div>
            <div class="fs-3 fw-bold"><%= @stats[:cars_count] %></div>
          </div>
        </div>
        <div class="progress" style="height: 4px;">
          <div class="progress-bar bg-purple" role="progressbar" style="width: 100%; background-color: #7c3aed;"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Autodeteções -->
  <div class="col-md-6 col-xl-3">
    <div class="card premium-card border-0 rounded-4 p-3 h-100">
      <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-3">
          <div class="icon-box bg-emerald-light mb-0 rounded-3" style="width: 48px; height: 48px;">
            <i class="bi bi-robot fs-4"></i>
          </div>
          <div>
            <div class="text-secondary small fw-bold text-uppercase tracking-wider" style="font-size: 0.7rem;">Autodeteções</div>
            <div class="fs-3 fw-bold"><%= @stats[:autodetections_count] %></div>
          </div>
        </div>
        <div class="progress" style="height: 4px;">
          <div class="progress-bar bg-success" role="progressbar" style="width: 100%"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Pendentes -->
  <div class="col-md-6 col-xl-3">
    <div class="card premium-card border-0 rounded-4 p-3 h-100">
      <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-3">
          <div class="icon-box bg-warning-light mb-0 rounded-3" style="width: 48px; height: 48px; background-color: rgba(255, 193, 7, 0.1); color: #ffc107;">
            <i class="bi bi-clock-history fs-4"></i>
          </div>
          <div>
            <div class="text-secondary small fw-bold text-uppercase tracking-wider" style="font-size: 0.7rem;">Em Processamento</div>
            <div class="fs-3 fw-bold"><%= @stats[:pending_autodetections] %></div>
          </div>
        </div>
        <div class="progress" style="height: 4px;">
          <div class="progress-bar bg-warning" role="progressbar" style="width: <%= (@stats[:pending_autodetections].to_f / [@stats[:autodetections_count], 1].max * 100).to_i %>%"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-lg-8">
    <div class="card premium-card border-0 rounded-4 overflow-hidden mb-4">
      <div class="card-header bg-white border-bottom p-4">
        <h5 class="mb-0 fw-bold">Atividade do Sistema</h5>
      </div>
      <div class="card-body p-4">
        <p class="text-muted">Gráficos de atividade e tendências aparecerão aqui.</p>
        <div class="bg-light rounded-4 d-flex align-items-center justify-content-center" style="height: 300px; border: 2px dashed #e2e8f0;">
          <div class="text-center">
            <i class="bi bi-graph-up display-4 text-muted mb-3"></i>
            <div class="text-secondary">Módulo de Gráficos (Sprint 2)</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card premium-card border-0 rounded-4 overflow-hidden">
      <div class="card-header bg-white border-bottom p-4">
        <h5 class="mb-0 fw-bold">Recursos Rápidos</h5>
      </div>
      <div class="card-body p-4 d-grid gap-2">
        <button class="btn btn-soft-secondary text-start p-3 d-flex align-items-center gap-3 rounded-3 opacity-50" disabled>
          <i class="bi bi-people fs-4 text-primary"></i>
          <div>
            <div class="fw-bold">Gerenciar Usuários</div>
            <div class="small">Ver e editar contas</div>
          </div>
        </button>
        <button class="btn btn-soft-secondary text-start p-3 d-flex align-items-center gap-3 rounded-3 opacity-50" disabled>
          <i class="bi bi-shield-lock fs-4 text-warning"></i>
          <div>
            <div class="fw-bold">Configurações Globais</div>
            <div class="small">Ajustar parâmetros do app</div>
          </div>
        </button>
      </div>
    </div>
  </div>
</div>
