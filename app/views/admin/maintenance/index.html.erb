<div class="mb-5">
  <h2 class="fw-bold mb-1 text-dark"><%= t('admin.maintenance.title') %></h2>
  <p class="text-muted mb-0"><%= t('admin.maintenance.subtitle') %></p>
</div>

<div class="row g-4 mb-4">
  <div class="col-md-6 col-lg-4">
    <div class="card premium-card border-0 rounded-3 p-4 h-100">
      <div class="d-flex align-items-center gap-3 mb-4">
        <div class="icon-box bg-indigo-light mb-0 rounded-3" style="width: 54px; height: 54px;">
          <i class="bi bi-hdd fs-3"></i>
        </div>
        <div>
          <div class="text-secondary small fw-bold text-uppercase tracking-wider"><%= t('admin.maintenance.storage.title') %></div>
          <div class="fs-4 fw-bold text-dark"><%= @uploads_size %></div>
        </div>
      </div>
      <p class="small text-muted mb-0"><%= t('admin.maintenance.storage.description_html') %></p>
    </div>
  </div>

  <div class="col-md-6 col-lg-4">
    <div class="card premium-card border-0 rounded-3 p-4 h-100">
      <div class="d-flex align-items-center gap-3 mb-4">
        <div class="icon-box bg-warning-light mb-0 rounded-3" style="width: 54px; height: 54px; background-color: rgba(255, 193, 7, 0.1); color: #ffc107;">
          <i class="bi bi-trash fs-3"></i>
        </div>
        <div>
          <div class="text-secondary small fw-bold text-uppercase tracking-wider"><%= t('admin.maintenance.cleanup.title') %></div>
          <div class="fs-4 fw-bold text-dark"><%= @old_records_count %></div>
        </div>
      </div>
      <div class="d-grid mt-auto">
        <%= button_to admin_maintenance_cleanup_path,
                      method: :post,
                      class: "btn btn-outline-warning rounded-3 py-2 fw-bold d-flex align-items-center justify-content-center gap-2",
                      disabled: @old_records_count == 0,
                      data: { turbo_frame: "_top", turbo_confirm: t('admin.maintenance.cleanup.confirm') } do %>
          <i class="bi bi-stars"></i> <%= t('admin.maintenance.cleanup.button') %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= turbo_frame_tag "maintenance_stats", data: { controller: "poll", poll_interval_value: 10000 } do %>
<div class="row">
  <div class="col-lg-12">
    <div class="card premium-card border-0 rounded-3 overflow-hidden">
      <div class="card-header bg-white border-bottom p-4">
        <div class="d-flex justify-content-between align-items-center">
          <h5 class="mb-0 fw-bold"><%= t('admin.maintenance.background_jobs.title') %></h5>
          <span class="badge bg-success-subtle text-success border border-success-subtle rounded-3 px-3"><%= t('admin.maintenance.background_jobs.active') %></span>
        </div>
      </div>
      <div class="card-body p-4">
        <div class="alert alert-primary border-0 rounded-3 d-flex align-items-center gap-3 mb-4">
          <i class="bi bi-cpu-fill fs-3"></i>
          <div>
            <div class="fw-bold"><%= t('admin.maintenance.background_jobs.engine') %></div>
            <div class="small"><%= t('admin.maintenance.background_jobs.description') %></div>
          </div>
        </div>

        <div class="row g-3">
          <div class="col-6 col-md-3">
            <div class="p-3 bg-light rounded-3 text-center border">
              <div class="text-secondary small fw-bold text-uppercase mb-1"><%= t('admin.maintenance.background_jobs.processed') %></div>
              <div class="fs-4 fw-bold text-dark"><%= number_with_delimiter(@sidekiq_stats.processed) %></div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="p-3 bg-light rounded-3 text-center border">
              <div class="text-secondary small fw-bold text-uppercase mb-1"><%= t('admin.maintenance.background_jobs.enqueued') %></div>
              <div class="fs-4 fw-bold text-dark"><%= number_with_delimiter(@sidekiq_stats.enqueued) %></div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="p-3 bg-light rounded-3 text-center border">
              <div class="text-secondary small fw-bold text-uppercase mb-1"><%= t('admin.maintenance.background_jobs.workers') %></div>
              <div class="fs-4 fw-bold text-success"><%= @sidekiq_workers %></div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="p-3 bg-danger-subtle rounded-3 text-center border border-danger-subtle">
              <div class="text-danger small fw-bold text-uppercase mb-1"><%= t('admin.maintenance.background_jobs.failed') %></div>
              <div class="fs-4 fw-bold text-danger"><%= number_with_delimiter(@sidekiq_stats.failed) %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<% end %>
