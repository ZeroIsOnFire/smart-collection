<% cache [I18n.locale, :home_catalog_landing_v4, user_signed_in?] do %>
<section class="hero-section">
  <%= image_tag "hero_car_collection_1775696111841.png",
                class: "hero-bg-image",
                alt: t("home.hero.image_alt") %>

  <div class="container hero-content">
    <div class="row align-items-center min-vh-75">
      <div class="col-lg-7 animate-fade-up">
        <div class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-3 mb-4 border border-primary border-opacity-25">
          <i class="bi bi-car-front me-1"></i> <%= t("home.hero.badge") %>
        </div>
        <h1 class="display-3 fw-bold tracking-tight mb-4">
          <%= t("home.hero.title") %>
        </h1>
        <p class="lead text-white text-opacity-75 mb-5 fs-4">
          <%= t("home.hero.subtitle") %>
        </p>
        <div class="d-flex flex-wrap gap-3">
          <% if user_signed_in? %>
            <%= link_to cars_path, class: "btn btn-primary btn-lg rounded-3 px-5 py-3 fs-5 fw-semibold d-flex align-items-center" do %>
              <i class="bi bi-grid-1x2 me-2 fs-4"></i>
              <%= t("home.hero.open_catalog") %> <i class="bi bi-arrow-right ms-2 mt-1"></i>
            <% end %>
            <%= link_to new_car_path, class: "btn btn-outline-light btn-lg rounded-3 px-5 py-3 fs-5" do %>
              <%= t("home.hero.add_car") %>
            <% end %>
          <% else %>
            <%= link_to new_user_registration_path, class: "btn btn-primary btn-lg rounded-3 px-5 py-3 fs-5 fw-semibold" do %>
              <%= t("home.hero.create_catalog") %> <i class="bi bi-arrow-right ms-2"></i>
            <% end %>
            <%= link_to "#features", class: "btn btn-outline-light btn-lg rounded-3 px-4 py-3 fs-5" do %>
              <%= t("home.hero.see_workflow") %>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="col-lg-5 d-none d-lg-block animate-fade-up" style="animation-delay: 0.2s;">
        <div class="catalog-sample-card p-4">
          <div class="catalog-sample-photo rounded-3 mb-4">
             <%= image_tag "diecast_shelf_sample.png",
                           alt: t("home.hero.sample_title"),
                           class: "catalog-sample-image" %>
          </div>
          <h4 class="fw-bold mb-2"><%= t("home.hero.sample_title") %></h4>
          <p class="text-muted small mb-0"><%= t("home.hero.sample_text") %></p>
        </div>
      </div>
    </div>
  </div>
</section>
<% end %>

<% cache [I18n.locale, :home_catalog_features_v3] do %>
<section id="features" class="py-5" style="background-color: var(--card-bg);">
  <div class="container py-5">
    <div class="text-center mb-5 animate-fade-up">
      <h2 class="display-5 fw-bold mb-3"><%= t("home.features.title") %></h2>
      <p class="text-muted lead mx-auto" style="max-width: 700px;">
        <%= t("home.features.subtitle") %>
      </p>
    </div>

    <div class="row g-4 justify-content-center">
      <% t("home.features.cards").each_with_index do |card, index| %>
        <div class="col-md-4 animate-fade-up" style="animation-delay: <%= (index + 1) * 0.1 %>s;">
          <div class="feature-card">
            <div class="icon-box <%= card[:icon_bg] %>">
              <i class="bi <%= card[:icon] %>"></i>
            </div>
            <h4 class="fw-bold mb-3"><%= card[:title] %></h4>
            <p class="text-muted mb-0"><%= card[:text] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<section class="py-5 border-top" style="background-color: var(--premium-background);">
  <div class="container py-5">
    <div class="row align-items-center">
      <div class="col-lg-6 mb-5 mb-lg-0">
        <% cache [I18n.locale, :home_catalog_cta_v3, user_signed_in?] do %>
        <h2 class="display-6 fw-bold mb-4"><%= t("home.cta.title") %></h2>
        <p class="lead text-muted mb-5"><%= t("home.cta.subtitle") %></p>
        <% end %>
        <% unless user_signed_in? %>
          <%= link_to t("home.cta.create_account"), new_user_registration_path, class: "btn btn-primary btn-lg rounded-3 px-5 py-3 fw-bold" %>
        <% else %>
           <%= link_to t("home.cta.open_catalog"), cars_path, class: "btn btn-primary btn-lg rounded-3 px-5 py-3 fw-bold" %>
        <% end %>
      </div>
      <% cache [I18n.locale, :home_catalog_cta_items_v3] do %>
      <div class="col-lg-6">
        <div class="p-4 shadow-sm rounded-3 border" style="background-color: var(--card-bg);">
          <% t("home.cta.items").each do |item| %>
            <div class="d-flex align-items-center mb-3">
               <div class="rounded-3 bg-success bg-opacity-10 d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px;">
                 <i class="bi bi-check-lg text-success"></i>
               </div>
               <span class="fw-semibold"><%= item %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
      <% end %>
  </div>
</section>

<% cache [I18n.locale, :home_catalog_footer_v3] do %>
<footer class="py-5 border-top" style="background-color: var(--card-bg);">
  <div class="container text-center">
    <div class="navbar-brand d-flex align-items-center justify-content-center mb-4 text-dark">
      <%= image_tag versioned_public_path("/logo/logo.png"),
                    alt: "Smart Collection",
                    height: 32,
                    class: "me-2 theme-logo",
                    data: {
                      theme_target: "logo",
                      dark_src: versioned_public_path("/logo/logo-dark.png"),
                      light_src: versioned_public_path("/logo/logo.png")
                    } %>
      <span class="fw-bold tracking-tight">Smart<span class="text-primary">Collection</span></span>
    </div>
    <p class="text-muted small"><%= t("home.footer.copyright", year: Time.current.year) %></p>
  </div>
</footer>
<% end %>
