<div data-controller="autodetection-upload">
  <button type="button"
          class="btn btn-premium rounded-pill px-4 d-flex align-items-center gap-2"
          data-bs-toggle="modal"
          data-bs-target="#autodetectModal">
    <i class="bi bi-magic"></i> <span><%= t('autodetections.form.button') %></span>
  </button>

  <div class="modal fade" id="autodetectModal" tabindex="-1" aria-labelledby="autodetectModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold" id="autodetectModalLabel"><%= t('autodetections.form.title') %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('actions.close') %>" data-action="click->autodetection-upload#stopCamera"></button>
        </div>

        <div class="modal-body p-4">
          <p class="text-muted small mb-4">
            <%= t('autodetections.form.description') %>
          </p>

          <%= form_with model: autodetection, url: autodetections_path,
                data: {
                  autodetection_upload_target: "form",
                  action: "turbo:submit-start->autodetection-upload#onStart turbo:submit-end->autodetection-upload#onComplete"
                },
                multipart: true do |f| %>

            <%= f.file_field :photo,
                  class: "d-none",
                  data: {
                    autodetection_upload_target: "input",
                    action: "change->autodetection-upload#fileSelected"
                  },
                  accept: "image/*" %>

            <div data-autodetection-upload-target="uploadInterface">
              <div class="dropzone-area mb-4"
                   data-autodetection-upload-target="dropzone"
                   data-action="dragover->autodetection-upload#dragOver dragleave->autodetection-upload#dragLeave drop->autodetection-upload#drop click->autodetection-upload#selectFile">
                <i class="bi bi-cloud-arrow-up display-4 text-primary mb-3"></i>
                <h6 class="fw-bold mb-1"><%= t('autodetections.form.dropzone_title') %></h6>
                <p class="text-muted small mb-0"><%= t('autodetections.form.dropzone_help') %></p>
                <%= render "shared/ai_upscaling_notice",
                           translation_key: "autodetections.form.ai_upscaling_notice",
                           minimum_side: AutodetectionService.autodetection_minimum_side %>
              </div>

              <div class="row g-3">
                <div class="col-6">
                  <button type="button" class="btn btn-premium rounded-pill w-100 py-3 d-flex align-items-center justify-content-center gap-2" data-action="click->autodetection-upload#openCamera">
                    <i class="bi bi-camera-fill d-block fs-4 mb-1"></i>
                    <span><%= t('autodetections.form.camera') %></span>
                  </button>
                </div>
                <div class="col-6">
                  <button type="button" class="btn btn-soft-secondary rounded-pill w-100 py-3 d-flex align-items-center justify-content-center gap-2" data-action="click->autodetection-upload#selectFile">
                    <i class="bi bi-images d-block fs-4 mb-1"></i>
                    <span><%= t('autodetections.form.gallery') %></span>
                  </button>
                </div>
              </div>
            </div>

            <div class="d-none" data-autodetection-upload-target="cameraInterface">
              <div class="camera-preview-container mb-3 shadow-sm">
                <video data-autodetection-upload-target="video" class="video-feed" playsinline></video>
                <div class="camera-controls">
                  <button type="button" class="btn-capture shadow" data-action="click->autodetection-upload#capture">
                    <i class="bi bi-camera"></i>
                  </button>
                </div>
              </div>
              <button type="button" class="btn btn-sm btn-soft-secondary rounded-pill w-100 d-inline-flex align-items-center justify-content-center gap-2" data-action="click->autodetection-upload#closeCamera">
                <i class="bi bi-arrow-left"></i>
                <span><%= t('autodetections.form.back_to_upload') %></span>
              </button>
            </div>

            <div class="mt-4 text-center d-none" data-autodetection-upload-target="previewContainer">
              <div class="mb-3">
                <img data-autodetection-upload-target="preview" class="img-fluid rounded shadow-sm border" style="max-height: 350px;">
              </div>

              <div class="row g-2">
                <div class="col-6">
                  <button type="button" class="btn btn-soft-secondary rounded-pill w-100 py-2 d-flex align-items-center justify-content-center gap-2" data-action="click->autodetection-upload#reset">
                    <i class="bi bi-arrow-left"></i> <span><%= t('actions.cancel') %></span>
                  </button>
                </div>
                <div class="col-6">
                  <button type="submit" id="autodetection_submit_btn" class="btn btn-premium rounded-pill w-100 py-2 d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-magic"></i> <span id="autodetection_submit_text"><%= t('actions.confirm') %></span>
                  </button>
                </div>
              </div>
              <p class="text-muted small mt-3 mb-0">
                <i class="bi bi-info-circle me-1"></i> <%= t('autodetections.form.confirm_help') %>
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
