<%
  border_class = case autodetection.status
                 when 'pending' then 'border-secondary'
                 when 'processing' then 'border-primary'
                 when 'to_verify' then 'border-warning'
                 when 'completed' then 'border-success'
                 when 'error' then 'border-danger'
                 end

  status_badge = case autodetection.status
                 when 'pending'
                   '<span class="badge bg-secondary">Aguardando</span>'
                 when 'processing'
                   '<span class="badge bg-primary"><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Processando...</span>'
                 when 'to_verify'
                   '<span class="badge bg-warning text-dark"><i class="bi bi-eye me-1"></i>Ação Necessária</span>'
                 when 'completed'
                   '<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Concluído</span>'
                 when 'error'
                   '<span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i>Erro</span>'
                 end
%>

<%= turbo_frame_tag "autodetection_#{autodetection.id}" do %>
  <div class="card shadow-sm border-0 border-start border-4 rounded mb-3 <%= border_class %>">
    <div class="card-body p-3 d-flex align-items-center">

      <!-- Miniatura -->
      <% if autodetection.photo? %>
        <%= image_tag autodetection.photo.url, class: "rounded object-fit-cover me-3", style: "width: 60px; height: 60px;" %>
      <% else %>
        <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted me-3" style="width: 60px; height: 60px;">
          <i class="bi bi-image"></i>
        </div>
      <% end %>

      <!-- Informações Principais -->
      <div class="flex-grow-1">
        <h6 class="mb-1 text-dark fw-bold">Autodetecção via Foto</h6>
        <div class="text-muted small">
          <i class="bi bi-clock me-1"></i> <%= autodetection.created_at.strftime("%d/%m/%Y às %H:%M") %>
        </div>
      </div>

      <!-- Área de Status e Ações -->
      <div class="d-flex flex-column align-items-end justify-content-center ms-3">
        <div class="mb-2 text-end">
          <%= status_badge.html_safe %>
        </div>

        <!-- Ações condicionais -->
        <% if autodetection.status == 'completed' || autodetection.status == 'to_verify' %>
          <div class="d-flex align-items-center gap-2">
            <%= button_to autodetection_path(autodetection), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Excluir esta autodetecção e todos os seus itens?" } }, title: "Excluir Registro" do %>
              <i class="bi bi-x-lg"></i>
            <% end %>
            <%= link_to "Verificar itens", autodetection_path(autodetection), class: "btn btn-sm #{autodetection.status == 'to_verify' ? 'btn-warning' : 'btn-outline-success'}", data: { turbo: false } %>
          </div>
        <% elsif autodetection.status == 'error' %>
          <div class="d-flex align-items-center">
            <span class="text-danger small me-3 text-end" style="max-width: 250px;"><%= autodetection.error_message %></span>
            <div class="d-flex gap-2">
              <%= button_to autodetection_path(autodetection), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Cancelar e remover este erro?" } }, title: "Remover" do %>
                <i class="bi bi-x-lg"></i>
              <% end %>
              <%= button_to "Tentar Novamente", retry_autodetection_path(autodetection), method: :patch, class: "btn btn-sm btn-danger" %>
            </div>
          </div>
        <% else %>
          <!-- pending ou processing -->
          <%= button_to autodetection_path(autodetection), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Cancelar e remover esta autodetecção?" } } do %>
            <i class="bi bi-x-circle me-1"></i> Parar
          <% end %>
        <% end %>
      </div>

    </div>
  </div>
<% end %>
