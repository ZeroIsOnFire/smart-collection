<%
  border_class = case autodetection.status
                 when 'pending' then 'border-secondary'
                 when 'processing' then 'border-primary'
                 when 'to_verify' then 'border-warning'
                 when 'completed' then 'border-success'
                 when 'error' then 'border-danger'
                 end

  status_badge = case autodetection.status
                 when 'pending'
                   "<span class=\"badge bg-secondary\">#{t('autodetections.status.pending')}</span>"
                 when 'processing'
                   "<span class=\"badge bg-primary\"><span class=\"spinner-border spinner-border-sm me-1\" role=\"status\" aria-hidden=\"true\"></span>#{t('autodetections.status.processing')}</span>"
                 when 'to_verify'
                   "<span class=\"badge bg-warning text-dark\"><i class=\"bi bi-eye me-1\"></i>#{t('autodetections.status.to_verify')}</span>"
                 when 'completed'
                   "<span class=\"badge bg-success\"><i class=\"bi bi-check-circle me-1\"></i>#{t('autodetections.status.completed')}</span>"
                 when 'error'
                   "<span class=\"badge bg-danger\"><i class=\"bi bi-exclamation-triangle me-1\"></i>#{t('autodetections.status.error')}</span>"
                 end
%>

<%= turbo_frame_tag "autodetection_#{autodetection.id}" do %>
  <div class="card premium-card autodetection-card shadow-sm border-start border-4 rounded-4 mb-3 <%= border_class %>">
    <div class="card-body p-3 d-flex align-items-center flex-wrap gap-3">

      <!-- Miniatura -->
      <% if autodetection.photo? %>
        <%= image_tag autodetection.photo.url, class: "rounded-3 object-fit-cover autodetection-thumb" %>
      <% else %>
        <div class="bg-light rounded-3 d-flex align-items-center justify-content-center text-muted autodetection-thumb">
          <i class="bi bi-image"></i>
        </div>
      <% end %>

      <!-- Informações Principais -->
      <div class="flex-grow-1">
        <h6 class="mb-1 text-dark fw-bold"><%= t('autodetections.title') %></h6>
        <div class="text-muted small">
          <i class="bi bi-clock me-1"></i> <%= l(autodetection.created_at, format: :short) rescue autodetection.created_at.strftime("%d/%m/%Y às %H:%M") %>
        </div>
      </div>

      <!-- Área de Status e Ações -->
      <div class="d-flex flex-column align-items-end justify-content-center ms-auto">
        <div class="mb-2 text-end">
          <%= status_badge.html_safe %>
        </div>

        <!-- Ações condicionais -->
        <% if autodetection.status == 'completed' || autodetection.status == 'to_verify' %>
          <div class="d-flex align-items-center gap-2">
            <%= button_to autodetection_path(autodetection), method: :delete, class: "btn btn-soft-danger btn-sm rounded-circle d-inline-flex align-items-center justify-content-center autodetection-icon-button", form: { data: { turbo_confirm: t('autodetections.actions.delete_confirm') } }, title: t('actions.delete') do %>
              <i class="bi bi-x-lg"></i>
            <% end %>
            <%= link_to autodetection_path(autodetection), class: "btn btn-sm #{autodetection.status == 'to_verify' ? 'btn-premium' : 'btn-soft-secondary'} rounded-pill px-3 d-inline-flex align-items-center gap-2", data: { turbo: false } do %>
              <i class="bi bi-eye"></i>
              <%= t('autodetections.actions.verify_items') %>
            <% end %>
          </div>
        <% elsif autodetection.status == 'error' %>
          <div class="d-flex align-items-center">
            <span class="text-danger small me-3 text-end" style="max-width: 250px;"><%= autodetection.error_message %></span>
            <div class="d-flex gap-2">
              <%= button_to autodetection_path(autodetection), method: :delete, class: "btn btn-soft-danger btn-sm rounded-circle d-inline-flex align-items-center justify-content-center autodetection-icon-button", form: { data: { turbo_confirm: t('autodetections.actions.cancel_confirm') } }, title: t('actions.delete') do %>
                <i class="bi bi-x-lg"></i>
              <% end %>
              <%= button_to retry_autodetection_path(autodetection), method: :patch, class: "btn btn-sm btn-premium rounded-pill px-3 d-inline-flex align-items-center gap-2" do %>
                <i class="bi bi-arrow-clockwise"></i>
                <%= t('autodetections.actions.retry') %>
              <% end %>
            </div>
          </div>
        <% else %>
          <!-- pending ou processing -->
          <%= button_to autodetection_path(autodetection), method: :delete, class: "btn btn-soft-danger btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-2", form: { data: { turbo_confirm: t('autodetections.actions.stop_confirm') } } do %>
            <i class="bi bi-x-circle me-1"></i> <%= t('autodetections.actions.stop') %>
          <% end %>
        <% end %>
      </div>

    </div>
  </div>
<% end %>
