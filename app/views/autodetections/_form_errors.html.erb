<% if autodetection.errors.any? %>
  <div class="alert alert-danger mb-3" role="alert">
    <div class="fw-bold mb-1"><%= t("autodetections.form.validation_error_title") %></div>
    <ul class="mb-0 ps-3">
      <% autodetection.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
