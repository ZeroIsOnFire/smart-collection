<div class="container-fluid py-5">
  <div class="row">
    <div class="col-12 px-lg-5">
      
      <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
          <h2 class="fw-bold mb-1 text-dark">Verificação de Autodetecção</h2>
          <p class="text-muted mb-0 lead">
            Revise as informações e adicione cada item à sua coleção.
          </p>
        </div>
        <div class="d-flex flex-wrap gap-2 justify-content-end">
          <%= link_to cars_path, class: "btn btn-outline-secondary rounded-pill px-4 shadow-sm" do %>
            <i class="bi bi-arrow-left me-2"></i> Voltar
          <% end %>

          <%= button_to autodetection_path(@autodetection), method: :delete, class: "btn btn-outline-danger rounded-pill px-4 shadow-sm", form: { data: { turbo_frame: "_top", turbo_confirm: "Cancelar e excluir todas as imagens extraídas permanentemente?" } } do %>
            <i class="bi bi-x-lg me-1"></i> Descartar e Sair
          <% end %>
        </div>
      </div>

      <div class="row g-4 mb-5">
        <!-- Foto Original de Referência -->
        <div class="col-lg-12">
          <div class="card border-0 shadow-sm overflow-hidden mb-4 rounded-4">
             <div class="card-header bg-white py-3">
               <h6 class="mb-0 fw-bold"><i class="bi bi-image me-2 text-primary"></i> Foto Original de Referência</h6>
             </div>
             <div class="position-relative bg-light">
               <%= image_tag @autodetection.photo.url, class: "img-fluid mx-auto d-block", style: "max-height: 500px; object-fit: contain;" if @autodetection.photo? %>
               
               <button type="button" 
                       class="btn btn-premium rounded-pill px-4 shadow position-absolute bottom-0 end-0 m-3"
                       data-bs-toggle="modal" 
                       data-bs-target="#manualAddModal">
                 <i class="bi bi-camera me-2"></i> Adicionar Manualmente
               </button>
             </div>
          </div>

          <!-- Container para Toasts Locais (Flashes nesta tela) -->
          <div id="local_toast_container" class="mb-4 d-flex flex-column align-items-center"></div>
        </div>

        <!-- Lista de Itens para Edição e Adição -->
        <div class="col-lg-12">
          <%= turbo_stream_from "autodetection_#{@autodetection.id}_items" %>
          <div id="detected_items_list_<%= @autodetection.id %>" class="row g-3">
            <% if @autodetection.detected_items.any? %>
              <%= render partial: "detected_items/detected_item", collection: @autodetection.detected_items %>
            <% else %>
              <div class="col-12 text-center py-5">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <p class="text-muted">Aguardando processamento dos itens... eles aparecerão aqui automaticamente.</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</div>

<!-- Modal de Adição Manual -->
<div class="modal fade" id="manualAddModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4"
         data-controller="manual-selection"
         data-manual-selection-create-url-value="<%= autodetection_detected_items_path(@autodetection) %>">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold"><i class="bi bi-camera me-2 text-primary"></i> Adicionar itens da foto</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <p class="text-muted small mb-4">
          Selecione o carro na foto original abaixo clicando e arrastando. 
          Ao clicar em adicionar, o item aparecerá na lista e você poderá selecionar outro item sem fechar esta tela.
        </p>
        
        <div class="bg-light rounded-3 overflow-hidden position-relative" 
             style="max-height: 60vh;">
          
          <img src="<%= @autodetection.photo.url %>" 
               class="img-fluid d-block mx-auto" 
               data-manual-selection-target="image">
        </div>
      </div>

      <div class="modal-footer border-0 p-4 pt-0">
        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Fechar</button>
        <button type="button" 
                class="btn btn-premium rounded-pill px-4"
                data-action="click->manual-selection#save">
          <i class="bi bi-plus-circle me-1"></i> Adicionar Item selecionado
        </button>
      </div>
    </div>
  </div>
</div>

<style>
 .btn-premium {
    background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
    color: white;
    border: none;
    transition: all 0.3s ease;
  }
  .btn-premium:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3);
    color: white;
  }
</style>
