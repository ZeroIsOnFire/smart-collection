<%= render "devise/auth_styles" %>

<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-logo">
        <%= image_tag "/logo/logo.png", alt: "Smart Collection", height: 60, class: "theme-logo", data: { theme_target: "logo", dark_src: "/logo/logo-dark.png", light_src: "/logo/logo.png" } %>
      </div>
      <h1 class="auth-title"><%= t('devise.ui.registrations.new.title') %></h1>
      <p class="auth-subtitle"><%= t('devise.ui.registrations.new.subtitle') %></p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { data: { turbo: false } }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="form-group">
        <%= f.label :name, t('devise.ui.registrations.new.name_label') %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name",
            placeholder: t('devise.ui.registrations.new.name_placeholder'), class: "form-input",
            id: "user_name" %>
      </div>

      <div class="form-group">
        <%= f.label :email, t('devise.ui.registrations.new.email_label') %>
        <%= f.email_field :email, autocomplete: "email",
            placeholder: t('devise.ui.registrations.new.email_placeholder'), class: "form-input",
            id: "user_email_signup" %>
      </div>

      <div class="form-group">
        <%= f.label :password, t('devise.ui.registrations.new.password_label') %>
        <% if @minimum_password_length %>
          <span class="form-hint"><%= t('devise.ui.registrations.new.password_hint', count: @minimum_password_length) %></span>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password",
            placeholder: t('devise.ui.registrations.new.password_placeholder'), class: "form-input",
            id: "user_password_signup",
            data: { action: "input->password-strength#evaluate" } %>
        <div class="password-strength" id="password_strength_bar">
          <div class="password-strength-bar" id="password_strength_fill"></div>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation, t('devise.ui.registrations.new.password_confirmation_label') %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
            placeholder: t('devise.ui.registrations.new.password_confirmation_placeholder'), class: "form-input",
            id: "user_password_confirmation" %>
      </div>

      <div class="form-actions">
        <%= f.submit t('devise.ui.registrations.new.submit'), class: "btn-primary", id: "sign_up_submit" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= t('devise.ui.registrations.new.already_have_account') %> <%= link_to t('devise.ui.registrations.new.sign_in_link'), new_session_path(resource_name) %>
    </div>
  </div>
</div>

<script>
  (function() {
    var input = document.getElementById('user_password_signup');
    var fill  = document.getElementById('password_strength_fill');
    if (!input || !fill) return;
    input.addEventListener('input', function() {
      var v = input.value;
      fill.className = 'password-strength-bar';
      if (v.length === 0) return;
      if (v.length < 8) {
        fill.classList.add('strength-weak');
      } else if (v.length < 12 || !/[^a-zA-Z0-9]/.test(v)) {
        fill.classList.add('strength-medium');
      } else {
        fill.classList.add('strength-strong');
      }
    });
  })();
</script>
