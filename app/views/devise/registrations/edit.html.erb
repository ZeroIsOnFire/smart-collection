<div class="container-fluid py-4 app-container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="fw-bold mb-0 fs-3"><%= t('devise.ui.registrations.edit.title') %></h1>
      <p class="text-muted small mb-0"><%= t('devise.ui.registrations.edit.subtitle') %></p>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-12 col-lg-8">
      <div class="card premium-card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
        <div class="card-body p-4 p-md-5">
          <h4 class="fw-bold mb-4"><%= t('devise.ui.registrations.edit.profile_title') %></h4>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, data: { turbo: false } }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <%= f.label :name, t('devise.ui.registrations.edit.name_label'), class: "form-label fw-medium" %>
                <%= f.text_field :name, autofocus: true, class: "form-control bg-light border-0 py-2", placeholder: t('devise.ui.registrations.edit.name_placeholder') %>
              </div>
              <div class="col-md-6">
                <%= f.label :email, t('devise.ui.registrations.edit.email_label'), class: "form-label fw-medium" %>
                <%= f.email_field :email, autocomplete: "email", class: "form-control bg-light border-0 py-2", placeholder: t('devise.ui.registrations.edit.email_placeholder') %>
              </div>
            </div>

            <div class="mb-4">
              <%= f.label :locale, t('devise.ui.registrations.edit.locale_label'), class: "form-label fw-medium" %>
              <%= f.select :locale,
                           [[t('devise.ui.registrations.edit.locales.en'), 'en'],
                            [t('devise.ui.registrations.edit.locales.pt-BR'), 'pt-BR']],
                           {},
                           class: "form-select bg-light border-0 py-2",
                           aria: { describedby: "user_locale_help" } %>
              <p id="user_locale_help" class="form-text text-muted small mb-0">
                <%= t('devise.ui.registrations.edit.locale_help') %>
              </p>
            </div>

            <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
              <div class="alert alert-warning mb-4">
                <%= t('devise.ui.registrations.edit.pending_confirmation', email: resource.unconfirmed_email) %>
              </div>
            <% end %>

            <hr class="my-4 opacity-10">

            <h5 class="fw-bold mb-3"><%= t('devise.ui.registrations.edit.password_title') %></h5>
            <p class="text-muted small mb-4"><%= t('devise.ui.registrations.edit.password_help') %></p>

            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <%= f.label :password, t('devise.ui.registrations.edit.new_password_label'), class: "form-label fw-medium" %>
                <%= f.password_field :password, autocomplete: "new-password", class: "form-control bg-light border-0 py-2", placeholder: (@minimum_password_length ? t('devise.ui.registrations.edit.new_password_placeholder', count: @minimum_password_length) : nil) %>
              </div>
              <div class="col-md-6">
                <%= f.label :password_confirmation, t('devise.ui.registrations.edit.password_confirmation_label'), class: "form-label fw-medium" %>
                <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control bg-light border-0 py-2", placeholder: t('devise.ui.registrations.edit.password_confirmation_placeholder') %>
              </div>
            </div>

            <hr class="my-4 opacity-10">

            <h5 class="fw-bold mb-3"><%= t('devise.ui.registrations.edit.current_password_title') %></h5>
            <p class="text-muted small mb-4"><%= t('devise.ui.registrations.edit.current_password_help') %></p>

            <div class="mb-4">
              <%= f.label :current_password, t('devise.ui.registrations.edit.current_password_label'), class: "form-label fw-medium" %>
              <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control bg-light border-0 py-2", required: true, placeholder: t('devise.ui.registrations.edit.current_password_placeholder') %>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-5">
              <%= link_to t('devise.ui.registrations.edit.back'), :back, class: "btn btn-light rounded-3 px-4" %>
              <%= f.submit t('devise.ui.registrations.edit.submit'), class: "btn btn-primary rounded-3 px-4" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-4">
      <% if ImageUpscalerService.service_configured? %>
        <div class="card premium-card border-0 shadow-sm rounded-3 overflow-hidden">
          <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-3">
              <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                <i class="bi bi-stars fs-4"></i>
              </div>
              <h5 class="fw-bold mb-0"><%= t('devise.ui.registrations.edit.ai_upscaling_title') %></h5>
            </div>

            <div id="ai_upscaling_settings_toggle">
              <%= render partial: "cars/ai_upscaling_settings" %>
            </div>
          </div>
        </div>
      <% end %>

      <div class="card border-0 shadow-sm rounded-3 overflow-hidden mt-4">
        <div class="card-body p-4">
          <h5 class="fw-bold text-danger mb-3"><%= t('devise.ui.registrations.edit.cancel_title') %></h5>
          <p class="text-muted small mb-4"><%= t('devise.ui.registrations.edit.cancel_help') %></p>
          <%= button_to t('devise.ui.registrations.edit.destroy_account'), registration_path(resource_name), data: { confirm: t('devise.ui.registrations.edit.destroy_confirm'), turbo_confirm: t('devise.ui.registrations.edit.destroy_confirm') }, method: :delete, class: "btn btn-outline-danger rounded-3 w-100" %>
        </div>
      </div>
    </div>
  </div>
</div>
