<div class="container-fluid py-4 app-container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="fw-bold mb-0 fs-3">Configurações de Conta</h1>
      <p class="text-muted small mb-0">Gerencie seu perfil e configurações de segurança</p>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-12 col-lg-8">
      <div class="card premium-card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-4 p-md-5">
          <h4 class="fw-bold mb-4">Perfil e Segurança</h4>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, data: { turbo: false } }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <%= f.label :name, "Nome", class: "form-label fw-medium" %>
                <%= f.text_field :name, autofocus: true, class: "form-control bg-light border-0 py-2", placeholder: "Seu nome" %>
              </div>
              <div class="col-md-6">
                <%= f.label :email, "Email", class: "form-label fw-medium" %>
                <%= f.email_field :email, autocomplete: "email", class: "form-control bg-light border-0 py-2", placeholder: "seu@email.com" %>
              </div>
            </div>

            <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
              <div class="alert alert-warning mb-4">
                Aguardando confirmação para: <%= resource.unconfirmed_email %>
              </div>
            <% end %>

            <hr class="my-4 opacity-10">

            <h5 class="fw-bold mb-3">Alterar Senha</h5>
            <p class="text-muted small mb-4">Deixe em branco se não quiser alterar a sua senha atual.</p>

            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <%= f.label :password, "Nova senha", class: "form-label fw-medium" %>
                <%= f.password_field :password, autocomplete: "new-password", class: "form-control bg-light border-0 py-2", placeholder: "Mínimo de #{@minimum_password_length} caracteres" %>
              </div>
              <div class="col-md-6">
                <%= f.label :password_confirmation, "Confirme a nova senha", class: "form-label fw-medium" %>
                <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control bg-light border-0 py-2", placeholder: "Repita a nova senha" %>
              </div>
            </div>

            <hr class="my-4 opacity-10">

            <h5 class="fw-bold mb-3">Senha Atual</h5>
            <p class="text-muted small mb-4">Precisamos da sua senha atual para confirmar as alterações feitas acima.</p>

            <div class="mb-4">
              <%= f.label :current_password, "Senha atual", class: "form-label fw-medium" %>
              <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control bg-light border-0 py-2", required: true, placeholder: "Sua senha atual" %>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-5">
              <%= link_to "Voltar", :back, class: "btn btn-light rounded-pill px-4" %>
              <%= f.submit "Salvar Alterações", class: "btn btn-primary rounded-pill px-4" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-4">
      <!-- Public Sharing Settings Card -->
      <div class="card premium-card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
              <i class="bi bi-globe fs-4"></i>
            </div>
            <h5 class="fw-bold mb-0">Visão Pública</h5>
          </div>

          <p class="text-muted small mb-4">
            Ative o compartilhamento público para permitir que outras pessoas visualizem a sua coleção através de um link exclusivo.
          </p>

          <div id="sharing_settings_toggle">
            <%= render partial: "cars/sharing_settings" %>
          </div>
        </div>
      </div>

      <!-- Cancel Account Card -->
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden mt-4">
        <div class="card-body p-4">
          <h5 class="fw-bold text-danger mb-3">Encerrar Conta</h5>
          <p class="text-muted small mb-4">Ao excluir sua conta, todos os seus dados e coleções serão removidos permanentemente. Esta ação não pode ser desfeita.</p>
          <%= button_to "Excluir minha conta", registration_path(resource_name), data: { confirm: "Tem certeza que deseja excluir sua conta?", turbo_confirm: "Tem certeza que deseja excluir sua conta?" }, method: :delete, class: "btn btn-outline-danger rounded-pill w-100" %>
        </div>
      </div>
    </div>
  </div>
</div>
