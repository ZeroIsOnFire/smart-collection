<style>
  /* ===== Auth Shared Styles ===== */
  :root {
    --auth-ink: #1f2933;
    --auth-muted: #68737d;
    --auth-surface: #fffdfa;
    --auth-border: #ded6ca;
    --auth-primary: #7c4f22;
    --auth-primary-hover: #663f19;
    --auth-primary-soft: #f3e8da;
    --auth-focus: #2f6f68;
    --auth-shadow: rgba(63, 49, 35, 0.14);
  }

  .auth-container {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .auth-card {
    background: var(--auth-surface);
    border: 1px solid var(--auth-border);
    border-radius: 8px;
    box-shadow: 0 14px 34px var(--auth-shadow);
    padding: 2.75rem 2.25rem;
    width: 100%;
    max-width: 440px;
  }

  .auth-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .auth-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.1rem;
  }

  .auth-title {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--auth-ink);
    margin: 0 0 0.3rem;
    letter-spacing: 0;
  }

  .auth-subtitle {
    color: var(--auth-muted);
    margin: 0;
    font-size: 0.95rem;
  }

  .form-group {
    margin-bottom: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #374151;
  }

  .form-hint {
    font-size: 0.78rem;
    color: var(--auth-muted);
  }

  .form-input {
    padding: 0.65rem 0.9rem;
    border: 1.5px solid var(--auth-border);
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.18s, box-shadow 0.18s;
    background: #fffaf3;
    color: var(--auth-ink);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--auth-focus);
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(47, 111, 104, 0.16);
  }

  .form-input::placeholder {
    color: #9b948c;
  }

  .password-visibility {
    position: relative;
    width: 100%;
  }

  .password-visibility-input {
    padding-right: 3rem;
  }

  .password-visibility-toggle {
    position: absolute;
    top: 50%;
    right: 0.35rem;
    width: 2.35rem;
    height: 2.35rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--auth-muted);
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s;
    transform: translateY(-50%);
  }

  .password-visibility-toggle:hover,
  .password-visibility-toggle:focus {
    color: var(--auth-primary);
    background: var(--auth-primary-soft);
  }

  .password-visibility-toggle:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(47, 111, 104, 0.16);
  }

  /* Password strength bar */
  .password-strength {
    margin-top: 4px;
    height: 4px;
    border-radius: 4px;
    background: #e5e7eb;
    overflow: hidden;
    transition: all 0.3s;
  }

  .password-strength-bar {
    height: 100%;
    border-radius: 4px;
    width: 0%;
    transition: width 0.3s, background-color 0.3s;
  }

  .strength-weak   { width: 33%; background: #ef4444; }
  .strength-medium { width: 66%; background: #f59e0b; }
  .strength-strong { width: 100%; background: #10b981; }

  .form-remember {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #374151;
    margin-bottom: 1rem;
  }

  .form-actions {
    margin-top: 1.5rem;
  }

  .btn-primary {
    width: 100%;
    padding: 0.8rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    background: var(--auth-primary);
    color: white;
    font-size: 1rem;
    font-weight: 600;
    font-family: inherit;
    letter-spacing: 0;
    transition: background-color 0.2s, transform 0.1s, box-shadow 0.2s;
    box-shadow: 0 4px 12px rgba(124, 79, 34, 0.24);
  }

  .btn-primary:hover {
    background: var(--auth-primary-hover);
    box-shadow: 0 6px 16px rgba(124, 79, 34, 0.28);
  }

  .btn-primary:active {
    transform: scale(0.99);
  }

  .btn-primary:disabled {
    cursor: wait;
    opacity: 0.82;
    transform: none;
  }

  .auth-submit-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
  }

  .auth-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.5rem 0;
    color: #d1d5db;
    font-size: 0.8rem;
  }

  .auth-divider::before,
  .auth-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: #e5e7eb;
  }

  .auth-links {
    text-align: center;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: #6b7280;
  }

  .auth-links a {
    color: var(--auth-primary);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.15s;
  }

  .auth-links a:hover {
    color: var(--auth-primary-hover);
    text-decoration: underline;
  }

  /* Flash / Error Messages */
  #error_explanation {
    background: #fef2f2;
    border: 1.5px solid #fecaca;
    border-radius: 8px;
    padding: 0.85rem 1rem;
    margin-bottom: 1.25rem;
  }

  #error_explanation h2 {
    font-size: 0.875rem;
    color: #dc2626;
    margin: 0 0 0.5rem;
    font-weight: 600;
  }

  #error_explanation ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  #error_explanation li {
    font-size: 0.875rem;
    color: #dc2626;
    margin-bottom: 2px;
  }
  /* ===== Dark Mode Overrides ===== */
  [data-theme="dark"] .auth-card {
    background: #15191c;
    border-color: #3c3329;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.34);
  }

  [data-theme="dark"] .auth-title {
    color: var(--text-main);
  }

  [data-theme="dark"] .auth-subtitle {
    color: var(--text-muted);
  }

  [data-theme="dark"] .form-group label {
    color: var(--text-main);
  }

  [data-theme="dark"] .form-input {
    background: #1d2225;
    border-color: #4a4035;
    color: #f7f1e8;
  }

  [data-theme="dark"] .form-input:focus {
    border-color: #78a6a0;
    box-shadow: 0 0 0 3px rgba(120, 166, 160, 0.22);
  }

  [data-theme="dark"] .form-input:-webkit-autofill,
  [data-theme="dark"] .form-input:-webkit-autofill:hover,
  [data-theme="dark"] .form-input:-webkit-autofill:focus,
  [data-theme="dark"] .form-input:-webkit-autofill:active {
    -webkit-text-fill-color: #f7f1e8;
    caret-color: #f7f1e8;
    -webkit-box-shadow: 0 0 0 1000px #1d2225 inset;
    box-shadow: 0 0 0 1000px #1d2225 inset;
    transition: background-color 5000s ease-in-out 0s;
  }

  [data-theme="dark"] .password-visibility-toggle {
    color: #cbd5e1;
  }

  [data-theme="dark"] .password-visibility-toggle:hover,
  [data-theme="dark"] .password-visibility-toggle:focus {
    color: #f0c17b;
    background: rgba(240, 193, 123, 0.12);
  }

  [data-theme="dark"] .form-remember {
    color: var(--text-muted);
  }

  [data-theme="dark"] .auth-links {
    color: var(--text-muted);
  }

  [data-theme="dark"] .auth-links a {
    color: #f0c17b;
  }

  [data-theme="dark"] .auth-divider {
    color: #475569;
  }

  [data-theme="dark"] .auth-divider::before,
  [data-theme="dark"] .auth-divider::after {
    background: #334155;
  }

  [data-theme="dark"] #error_explanation {
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.2);
  }
</style>
