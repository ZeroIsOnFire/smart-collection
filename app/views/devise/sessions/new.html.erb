<%= render "devise/auth_styles" %>

<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-logo">
        <%= image_tag "/logo/logo.png", alt: "Smart Collection", height: 60, class: "theme-logo", data: { theme_target: "logo", dark_src: "/logo/logo-dark.png", light_src: "/logo/logo.png" } %>
      </div>
      <h1 class="auth-title"><%= t('devise.ui.sessions.new.title') %></h1>
      <p class="auth-subtitle"><%= t('devise.ui.sessions.new.subtitle') %></p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name),
                 html: {
                   data: {
                     controller: "auth-submit",
                     action: "submit->auth-submit#start",
                     turbo: false,
                     auth_submit_loading_text_value: t('javascript.auth_submit.loading')
                   }
                 }) do |f| %>
      <div class="form-group">
        <%= f.label :email, t('devise.ui.sessions.new.email_label') %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            placeholder: t('devise.ui.sessions.new.email_placeholder'), class: "form-input",
            id: "user_email_login" %>
      </div>

      <div class="form-group">
        <%= f.label :password, t('devise.ui.sessions.new.password_label') %>
        <%= f.password_field :password, autocomplete: "current-password",
            placeholder: t('devise.ui.sessions.new.password_placeholder'), class: "form-input",
            id: "user_password_login" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-remember">
          <%= f.check_box :remember_me, id: "user_remember_me" %>
          <%= f.label :remember_me, t('devise.ui.sessions.new.remember_me') %>
        </div>
      <% end %>

      <div class="form-actions">
        <button type="submit"
                class="btn-primary auth-submit-button"
                id="sign_in_submit"
                data-auth-submit-target="submit">
          <span class="spinner-border spinner-border-sm d-none" aria-hidden="true" data-auth-submit-target="spinner"></span>
          <span data-auth-submit-target="label"><%= t('devise.ui.sessions.new.submit') %></span>
        </button>
      </div>
    <% end %>

    <div class="auth-links">
      <% if devise_mapping.registerable? && controller_name != 'registrations' %>
        <%= t('devise.ui.sessions.new.no_account') %> <%= link_to t('devise.ui.sessions.new.sign_up_link'), new_registration_path(resource_name) %>
      <% end %>
      <% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
        <br><%= link_to t('devise.ui.sessions.new.forgot_password'), new_password_path(resource_name) %>
      <% end %>
    </div>
  </div>
</div>
