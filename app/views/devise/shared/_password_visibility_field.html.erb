<% input_options = local_assigns.fetch(:input_options, {}) %>
<% field_id = input_options[:id] %>
<% input_data = input_options.fetch(:data, {}).merge(password_visibility_target: "input") %>
<% input_html_options = input_options.merge(data: input_data) %>
<% input_html_options[:class] = [input_options[:class], "password-visibility-input"].compact.join(" ") %>

<div class="password-visibility"
     data-controller="password-visibility"
     data-password-visibility-show-label-value="<%= t('devise.ui.password_visibility.show') %>"
     data-password-visibility-hide-label-value="<%= t('devise.ui.password_visibility.hide') %>">
  <%= form.password_field field, input_html_options %>
  <button type="button"
          class="password-visibility-toggle"
          aria-label="<%= t('devise.ui.password_visibility.show') %>"
          aria-controls="<%= field_id %>"
          aria-pressed="false"
          title="<%= t('devise.ui.password_visibility.show') %>"
          data-action="password-visibility#toggle"
          data-password-visibility-target="button">
    <i class="bi bi-eye" aria-hidden="true" data-password-visibility-target="icon"></i>
  </button>
</div>
