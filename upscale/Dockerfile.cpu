FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV UPSCALE_RUNTIME=cpu

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.lock requirements.txt
COPY constraints.txt .
RUN python -c "import sys; assert sys.version_info >= (3, 11), 'Pillow 13 requires Python 3.11+'" \
    && python -m pip install --upgrade -c constraints.txt pip setuptools \
    && sed -i '/^torch/d;/^torchvision/d' requirements.txt \
    && python -m pip install torch==2.13.0+cpu torchvision==0.28.0+cpu --index-url https://download.pytorch.org/whl/cpu \
    # BasicSR setup_requires must reuse the selected PyTorch runtime.
    && python -m pip install --no-build-isolation -r requirements.txt \
    && python -m pip check

COPY main.py .

RUN mkdir -p /app/models \
    && curl -L --fail -o /app/models/realesr-general-x4v3.pth https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.5.0/realesr-general-x4v3.pth

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
