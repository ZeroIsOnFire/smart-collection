FROM rocm/pytorch:rocm6.4.2_ubuntu24.04_py3.12_pytorch_release_2.6.0

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV UPSCALE_RUNTIME=amd

# Install runtime dependencies for OpenCV and system utilities
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install requirements.
# Since rocm/pytorch already contains optimized PyTorch and Torchvision, we only install the other deps
COPY requirements.txt .
RUN pip install --upgrade pip \
    && sed -i '/torch/d' requirements.txt \
    && pip install -r requirements.txt

COPY main.py .

RUN mkdir -p /app/models \
    && curl -L --fail -o /app/models/4x_NMKD-Siax_200k.pth https://huggingface.co/f5aiteam/Upscale_Models/resolve/main/4x_NMKD-Siax_200k.pth

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
