FROM rocm/pytorch:latest

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

# Install runtime dependencies for OpenCV and system utilities
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install requirements.
# Since rocm/pytorch already contains optimized PyTorch and Torchvision, we only install the other deps
COPY requirements.txt .
RUN pip install --upgrade pip \
    && sed -i '/torch/d' requirements.txt \
    && pip install -r requirements.txt

COPY main.py .

RUN mkdir -p /app/models \
    && curl -L --fail -o /app/models/4x-UltraSharp.pth https://huggingface.co/lokCX/4x-Ultrasharp/resolve/main/4x-UltraSharp.pth \
    && curl -L --fail -o /app/models/realesr-general-x4v3.pth https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.5.0/realesr-general-x4v3.pth \
    && curl -L --fail -o /app/models/ESPCN_x4.pb https://github.com/fannymonori/TF-ESPCN/raw/master/export/ESPCN_x4.pb

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
