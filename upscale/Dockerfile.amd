FROM rocm/pytorch:rocm7.14.1_ubuntu24.04_py3.12_pytorch_release_2.12.0@sha256:cc9b00f90b85c97b015b040fa55c8d1b404b7cacc6ad57d74ee3451c97508da1

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV UPSCALE_RUNTIME=amd

# Install runtime dependencies for OpenCV and system utilities
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

# Keep ROCm 7.14 and use the official compatible pair: the base torch 2.12
# requires setuptools<82, which prevents the setuptools security update.
COPY requirements.lock requirements.txt
COPY constraints.txt .
RUN python -c "import sys; assert sys.version_info >= (3, 11), 'Pillow 13 requires Python 3.11+'" \
    && python -m pip install --upgrade -c constraints.txt pip \
    # Remove split kernels tied to the old pair; the official wheels include them.
    && python -m pip list --format=freeze \
        | sed -nE '/^amd-torch(vision)?-device-/s/==.*//p' \
        | xargs -r python -m pip uninstall -y \
    # The new ROCm wheels provide Triton through the triton-rocm distribution.
    && python -m pip uninstall -y triton \
    && python -m pip install --upgrade torch==2.14.1+rocm7.14 torchvision==0.29.1+rocm7.14 --index-url https://download.pytorch.org/whl/rocm7.14 \
    && python -m pip install --upgrade -c constraints.txt setuptools \
    && if python -m pip show uv >/dev/null 2>&1; then python -m pip install --upgrade uv==0.13.4; fi \
    && python -m pip check

RUN sed -i '/^torch/d;/^torchvision/d' requirements.txt \
    # BasicSR setup_requires must reuse the selected PyTorch runtime.
    && python -m pip install --no-build-isolation -r requirements.txt torch==2.14.1+rocm7.14 torchvision==0.29.1+rocm7.14 fsspec==2026.6.0 \
    && python -m pip check

COPY main.py .

RUN mkdir -p /app/models \
    && curl -L --fail -o /app/models/4x_NMKD-Siax_200k.pth https://huggingface.co/f5aiteam/Upscale_Models/resolve/main/4x_NMKD-Siax_200k.pth

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
