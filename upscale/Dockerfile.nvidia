FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV UPSCALE_RUNTIME=nvidia

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --upgrade pip \
    && sed -i '/^torch/d;/^torchvision/d' requirements.txt \
    && pip install -r requirements.txt

COPY main.py .

RUN mkdir -p /app/models \
    && curl -L --fail -o /app/models/4x_NMKD-Siax_200k.pth https://huggingface.co/f5aiteam/Upscale_Models/resolve/main/4x_NMKD-Siax_200k.pth

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
