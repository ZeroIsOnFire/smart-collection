#!/bin/bash -e

# Ensure permissions for file uploads
mkdir -p public/uploads storage

# Keep development containers in sync when Gemfile.lock changes under a bind mount.
if [ -f Gemfile ]; then
  bundle check || bundle install
fi

# Build JavaScript and CSS bundles when running from a mounted development workspace.
if [ -f package.json ] && command -v npm >/dev/null 2>&1; then
  if [ ! -d node_modules ]; then
    if [ -f package-lock.json ]; then
      npm ci
    else
      npm install
    fi
  fi

  npm run build
fi

# Remove a potentially pre-existing server.pid for Rails.
if [ -f tmp/pids/server.pid ]; then
  rm -f tmp/pids/server.pid
fi

exec "${@}"
