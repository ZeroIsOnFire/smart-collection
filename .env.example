# ============================================
# Smart Collection Catalog — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores.
# NÃO commite o arquivo .env no repositório.
# ============================================

# -------------------------------------------
# Rails (obrigatório)
# -------------------------------------------
RAILS_ENV=development
SECRET_KEY_BASE=sua_secret_key_base_aqui        # Gere com: rails secret
RAILS_MASTER_KEY=sua_master_key_aqui             # Localizado em config/master.key

# -------------------------------------------
# MongoDB (obrigatório)
# -------------------------------------------
MONGODB_USERNAME=scc_admin                         # Usuário root do MongoDB
MONGODB_PASSWORD=scc_dev                             # Senha root do MongoDB (TROCAR em produção!)
MONGODB_URI=mongodb://scc_admin:scc_dev@mongodb:27017/smart_collection_catalog_development?authSource=admin

# -------------------------------------------
# Redis (obrigatório)
# -------------------------------------------
REDIS_URL=redis://redis:6379/0

# -------------------------------------------
# YOLO Local Detection
# -------------------------------------------
YOLO_SERVICE_URL=http://yolo-service:8000
YOLO_API_KEY=sua_chave_secreta_compartilhada_aqui

# -------------------------------------------
# Image Upscale Local (opcional)
# -------------------------------------------
IMAGE_UPSCALE_SERVICE_URL=http://upscale-service:8000
IMAGE_UPSCALE_API_KEY=sua_chave_secreta_compartilhada_aqui
IMAGE_UPSCALE_DEFAULT_MINIMUM_SIDE=360
AUTODETECTION_MINIMUM_SIDE=1080

# -------------------------------------------
# Image Upscaler Service (tiers)
# -------------------------------------------
# Escolha CPU, NVIDIA ou AMD pelo Dockerfile do upscale-service:
#   Dockerfile.cpu, Dockerfile.nvidia, Dockerfile.amd ou Dockerfile.vulkan.
# O runtime Vulkan e experimental e deve ser usado apenas como opt-in.
# Opcional: caminho customizado de pesos dentro do container escolhido.
REAL_ESRGAN_MODEL_PATH=
VULKAN_BINARY_PATH=
VULKAN_MODEL_DIR=
VULKAN_MODEL_NAME=
REAL_ESRGAN_WDN_MODEL_PATH=
REAL_ESRGAN_DENOISE_STRENGTH=0

# Upscale tiers: ratio = current_min_side / minimum_side
# ratio < TIER_4X_THRESHOLD: Real-ESRGAN 4x
# ratio < TIER_2X_THRESHOLD: Real-ESRGAN 2x
# ratio >= TIER_2X_THRESHOLD: Denoise + Lanczos4
TIER_4X_THRESHOLD=0.50
TIER_2X_THRESHOLD=0.75

# Denoise aplicado antes do Lanczos4. Valores maiores = filtro mais agressivo.
DENOISE_H=7
DENOISE_TEMPLATE_WINDOW=7
DENOISE_SEARCH_WINDOW=21

# CAS (AMD FidelityFX Contrast Adaptive Sharpening) aplicado apos Lanczos4.
# Use 0 para desativar; aumente com cuidado para evitar halos.
LANCZOS_CAS_AMOUNT=0.35
