# ============================================
# Smart Collection Catalog — Variáveis de Ambiente / Environment Variables
# ============================================
# PT-BR: Copie este arquivo para .env e preencha os valores.
# EN: Copy this file to .env and fill in the values.
# PT-BR: NÃO commite o arquivo .env no repositório.
# EN: Do NOT commit the .env file to the repository.
# ============================================

# -------------------------------------------
# Rails (obrigatório / required)
# -------------------------------------------
RAILS_ENV=development
RAILS_ALLOWED_HOSTS=localhost,127.0.0.1,web
SECRET_KEY_BASE=sua_secret_key_base_aqui        # PT-BR: Gere com rails secret. EN: Generate with rails secret.
RAILS_MASTER_KEY=sua_master_key_aqui             # PT-BR: Em config/master.key. EN: Found in config/master.key.

# -------------------------------------------
# MongoDB (obrigatório / required)
# -------------------------------------------
MONGODB_USERNAME=scc_admin                         # PT-BR: Usuário root do MongoDB. EN: MongoDB root user.
MONGODB_PASSWORD=scc_dev                             # PT-BR: Troque em produção. EN: Change in production.
MONGODB_URI=mongodb://scc_admin:scc_dev@mongodb:27017/smart_collection_catalog_development?authSource=admin

# -------------------------------------------
# Redis (obrigatório / required)
# -------------------------------------------
REDIS_URL=redis://redis:6379/0

# -------------------------------------------
# YOLO Local Detection
# -------------------------------------------
YOLO_SERVICE_URL=http://yolo-service:8000
YOLO_API_KEY=sua_chave_secreta_compartilhada_aqui

# -------------------------------------------
# Image Upscale Local (opcional / optional)
# -------------------------------------------
IMAGE_UPSCALE_SERVICE_URL=http://upscale-service:8000
IMAGE_UPSCALE_API_KEY=sua_chave_secreta_compartilhada_aqui
IMAGE_UPSCALE_DEFAULT_MINIMUM_SIDE=360
IMAGE_UPSCALE_OPEN_TIMEOUT=5
IMAGE_UPSCALE_READ_TIMEOUT=180
IMAGE_UPSCALE_WRITE_TIMEOUT=30

# -------------------------------------------
# Image Upscaler Service (tiers / níveis)
# -------------------------------------------
# PT-BR: Escolha CPU, NVIDIA ou AMD pelo Dockerfile do upscale-service.
# EN: Select CPU, NVIDIA, or AMD through the upscale-service Dockerfile.
# PT-BR/EN: Dockerfile.cpu, Dockerfile.nvidia, Dockerfile.amd, or Dockerfile.vulkan.
# PT-BR: Vulkan é experimental e deve ser usado apenas como opt-in.
# EN: Vulkan is experimental and must only be used as opt-in.
# PT-BR: Caminho opcional de pesos no container escolhido.
# EN: Optional weights path inside the selected container.
REAL_ESRGAN_MODEL_PATH=
VULKAN_BINARY_PATH=
VULKAN_MODEL_DIR=
VULKAN_MODEL_NAME=
REAL_ESRGAN_WDN_MODEL_PATH=
REAL_ESRGAN_DENOISE_STRENGTH=0

# Upscale tiers: ratio = current_min_side / minimum_side
# ratio < TIER_4X_THRESHOLD: Real-ESRGAN 4x
# ratio < TIER_2X_THRESHOLD: Real-ESRGAN 2x
# ratio >= TIER_2X_THRESHOLD: Denoise + Lanczos4
TIER_4X_THRESHOLD=0.50
TIER_2X_THRESHOLD=0.75

# PT-BR: Denoise aplicado antes do Lanczos4; valores maiores usam filtro mais agressivo.
# EN: Denoise runs before Lanczos4; higher values use a more aggressive filter.
DENOISE_H=7
DENOISE_TEMPLATE_WINDOW=7
DENOISE_SEARCH_WINDOW=21

# PT-BR: CAS é aplicado após Lanczos4; use 0 para desativar e evite halos.
# EN: CAS runs after Lanczos4; use 0 to disable it and avoid halos.
LANCZOS_CAS_AMOUNT=0.35

# -------------------------------------------
# Observabilidade Grafana / Grafana Observability (opcional / optional)
# PT-BR: Ative antes de iniciar: docker compose --profile observability up -d
# EN: Enable before starting: docker compose --profile observability up -d
# -------------------------------------------
OBSERVABILITY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_EXPORTER_OTLP_GRPC_ENDPOINT=alloy:4317
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque_por_uma_senha_local_forte
GRAFANA_PORT=3001
PROMETHEUS_RETENTION=15d
