# ============================================
# Smart Collection Catalog — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores.
# NÃO commite o arquivo .env no repositório.
# ============================================

# -------------------------------------------
# Rails (obrigatório)
# -------------------------------------------
RAILS_ENV=development
SECRET_KEY_BASE=sua_secret_key_base_aqui        # Gere com: rails secret
RAILS_MASTER_KEY=sua_master_key_aqui             # Localizado em config/master.key

# -------------------------------------------
# MongoDB (obrigatório)
# -------------------------------------------
MONGODB_USERNAME=scc_admin                         # Usuário root do MongoDB
MONGODB_PASSWORD=scc_dev                             # Senha root do MongoDB (TROCAR em produção!)
MONGODB_URI=mongodb://scc_admin:scc_dev@mongodb:27017/smart_collection_catalog_development?authSource=admin

# -------------------------------------------
# Redis (obrigatório)
# -------------------------------------------
REDIS_URL=redis://redis:6379/0

# -------------------------------------------
# Google Cloud Vision API (fornecido pelo usuário)
# -------------------------------------------
# O usuário deve criar um projeto no Google Cloud Console,
# ativar a Vision API e gerar um arquivo de credenciais (Service Account JSON).
# Sem estas credenciais, a funcionalidade de indexação por foto ficará desabilitada.
# Guia: https://cloud.google.com/vision/docs/setup
GOOGLE_CLOUD_PROJECT_ID=seu_project_id_aqui
GOOGLE_CLOUD_CREDENTIALS_PATH=/rails/config/google_credentials.json

# -------------------------------------------
# YOLO Local Detection (Opcional - Substitui Vision API para carros)
# -------------------------------------------
YOLO_SERVICE_URL=http://yolo-service:8000
YOLO_API_KEY=sua_chave_secreta_compartilhada_aqui

# -------------------------------------------
# Image Upscale Local (Opcional - CPU)
# -------------------------------------------
IMAGE_UPSCALE_SERVICE_URL=http://upscale-service:8000
IMAGE_UPSCALE_API_KEY=sua_chave_secreta_compartilhada_aqui

# -------------------------------------------
# Image Upscaler Service (GPU/CPU routing + tiers)
# -------------------------------------------
# Set true to try GPU Real-ESRGAN. Keep false for CPU/local fallback setups.
USE_GPU_UPSCALER=false

# Optional custom paths if you provide your own weights inside the container.
REAL_ESRGAN_GPU_MODEL_PATH=/app/models/4x-UltraSharp.pth
REAL_ESRGAN_CPU_MODEL_PATH=/app/models/realesr-general-x4v3.pth

# Upscale tiers: ratio = current_min_side / minimum_side
# ratio < TIER_4X_THRESHOLD: Real-ESRGAN 4x
# ratio < TIER_2X_THRESHOLD: Denoise + Real-ESRGAN 2x
# ratio >= TIER_2X_THRESHOLD: Denoise + Lanczos4
TIER_4X_THRESHOLD=0.50
TIER_2X_THRESHOLD=0.75

# Denoise strength (cv2.fastNlMeansDenoisingColored). Valores maiores = filtro mais agressivo.
DENOISE_H=5
DENOISE_TEMPLATE_WINDOW=7
DENOISE_SEARCH_WINDOW=21
